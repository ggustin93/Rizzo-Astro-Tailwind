---
import { getEntry } from 'astro:content';
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SvgSprite from "../components/SvgSprite.astro";
import "../styles/global.css";
import { LOCALES, DEFAULT_LOCALE } from '../config/locales';

declare global {
  interface Window {
    Cal: any;
  }
}

const { 
  title, 
  description, 
  image, 
  keywords, 
  type = 'website', 
  canonical, 
  lang: propLang,
  allowIndexing: pageAllowIndexing
} = Astro.props;

const { lang: pathLang } = Astro.params;
const currentLang = propLang || pathLang || 'fr';

const siteConfigEntry = await getEntry('config', 'site-config');
if (!siteConfigEntry) {
  throw new Error("Site config entry not found! Make sure you have a `site-config.md` file in `src/content/config`.");
}
const { seo, sectionsVisibility, lawyers, allowIndexing: siteAllowIndexing } = siteConfigEntry.data;
// Get primary lawyer's calendar link (first in the list)
const calendarLink = lawyers?.[0]?.calendarLink || 'https://cal.com/c.rizzo-avocat.be/rendez-vous?duration=15';

const allowIndexing = pageAllowIndexing === undefined ? siteAllowIndexing : pageAllowIndexing;

const productionSiteUrl = seo.siteUrl || Astro.site || 'https://rizzo-michiels.be';
const siteUrl = import.meta.env.DEV ? Astro.url.origin : productionSiteUrl;

const siteName = seo.siteName || 'Christine Rizzo - Avocate';
const defaultDescription = seo.siteDescription || 'Avocate en droit du travail à Bruxelles.';
const defaultImage = seo.defaultSocialImage || '/default-social-image.png';

let fullImageUrl;
if (image && (image.startsWith('http://') || image.startsWith('https://'))) {
  fullImageUrl = image;
} else if (image) {
  fullImageUrl = new URL(image, siteUrl).toString();
} else {
  fullImageUrl = new URL(defaultImage, siteUrl).toString();
}

const finalTitle = title ? `${title} | ${siteName}` : siteName;
const finalDescription = description || defaultDescription;
const finalCanonical = canonical ? (new URL(canonical, siteUrl).toString()) : (new URL(Astro.url.pathname, siteUrl).toString());
const keywordsString = Array.isArray(keywords) ? keywords.join(', ') : keywords;

const supportedLanguages = LOCALES;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <ViewTransitions />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription}>
    <link rel="canonical" href={finalCanonical}>

    <!-- SEO Meta Tags -->
    {allowIndexing ? (
      <meta name="robots" content="index, follow">
    ) : (
      <meta name="robots" content="noindex, nofollow">
    )}
    <meta name="author" content={siteName}>
    <meta name="language" content={currentLang}>
    {keywordsString && <meta name="keywords" content={keywordsString}>}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type}>
    <meta property="og:url" content={finalCanonical}>
    <meta property="og:title" content={finalTitle}>
    <meta property="og:description" content={finalDescription}>
    <meta property="og:image" content={fullImageUrl}>
    <meta property="og:image:alt" content={`Image pour ${finalTitle}`}>
    <meta property="og:site_name" content={siteName}>
    <meta property="og:locale" content={currentLang}>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={finalCanonical}>
    <meta name="twitter:title" content={finalTitle}>
    <meta name="twitter:description" content={finalDescription}>
    <meta name="twitter:image" content={fullImageUrl}>
    <meta name="twitter:image:alt" content={`Image pour ${finalTitle}`}>
    <meta name="twitter:site" content="@ChristineRizzo">
    <meta name="twitter:creator" content="@ChristineRizzo">

    <!-- Hreflang links -->
    {supportedLanguages.map(l => (
        <link rel="alternate" hreflang={l} href={`${siteUrl}/${l}${pathname.substring(3)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/fr${pathname.substring(3)}`} />

    <!-- Préconnexions -->
    <link rel="preconnect" href="https://app.cal.com">
    <link rel="preconnect" href="https://unpkg.com">

    <!-- Favicons et manifeste -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Cal.com Script -->
    <script is:inline type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", {origin:"https://cal.com"});

    Cal("ui", {
      styles: {branding: {brandColor: "#000000"}},
      hideEventTypeDetails: false,
      layout: "month_view"
    });
    </script>
</head>
<body class="bg-beige bg-svg-pattern">
  <SvgSprite />
  <div class="container mx-auto px-4">
    <Header currentLang={currentLang}/>
    <main id="content">
      <slot />
    </main>
    <Footer currentLang={currentLang}/>
  </div>

  <!-- Script for Cal.com -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.body.addEventListener('click', function(e) {
        if (e.target instanceof HTMLElement && e.target.hasAttribute('data-cal-link')) {
          window.Cal("ui", {
            styles: {branding: {brandColor: "#000000"}},
            hideEventTypeDetails: false,
            layout: "month_view"
          });
        }
      });
    });
    </script>
    <!-- Script pour l'amélioration de l'accessibilité -->
    <script>
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Tab') {
          document.body.classList.add('user-is-tabbing');
        }
      });

      document.addEventListener('mousedown', function() {
        document.body.classList.remove('user-is-tabbing');
      });
    </script>
    <!-- Script pour le chargement paresseux des images -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var lazyImages = [].slice.call(document.querySelectorAll("img.lazy"));

        if ("IntersectionObserver" in window) {
          let lazyImageObserver = new IntersectionObserver(function(entries, observer) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                let lazyImage = entry.target;
                if (lazyImage instanceof HTMLImageElement && lazyImage.dataset.src) {
                    lazyImage.src = lazyImage.dataset.src;
                    lazyImage.classList.remove("lazy");
                    lazyImageObserver.unobserve(lazyImage);
                }
              }
            });
          });

          lazyImages.forEach(function(lazyImage) {
            lazyImageObserver.observe(lazyImage);
          });
        }
      });
    </script>
    
    <!-- Netlify Identity Invite Token Redirect Script -->
    <script>
      // Function to check and redirect invite tokens
      function checkAndRedirectToken() {
        const hash = window.location.hash;
        const searchParams = new URLSearchParams(window.location.search);
        
        // Check for invite_token, recovery_token, or confirmation_token in hash or query params
        const hasInviteToken = hash.includes('invite_token=') || searchParams.has('invite_token');
        const hasRecoveryToken = hash.includes('recovery_token=') || searchParams.has('recovery_token');
        const hasConfirmationToken = hash.includes('confirmation_token=') || searchParams.has('confirmation_token');
        
        // If we have a token AND we're not already on /admin/
        if ((hasInviteToken || hasRecoveryToken || hasConfirmationToken) && !window.location.pathname.includes('/admin')) {
          // Preserve the complete hash and query params for Netlify Identity
          const newUrl = window.location.origin + '/admin/' + window.location.hash + window.location.search;
          // Use replace to avoid adding to browser history
          window.location.replace(newUrl);
        }
      }
      
      // Run immediately on initial page load (for direct navigation via email link)
      checkAndRedirectToken();
      
      // Also run after Astro ViewTransitions navigation (for client-side routing)
      document.addEventListener('astro:page-load', checkAndRedirectToken);
    </script>
    <script is:inline>
      // Scroll to hash anchor after Astro View Transitions (browser doesn't do this automatically)
      document.addEventListener('astro:page-load', function() {
        const hash = window.location.hash;
        if (!hash) return;
        const target = document.querySelector(hash);
        if (!target) return;
        setTimeout(function() {
          target.scrollIntoView({ behavior: 'smooth' });
        }, 50);
      });
    </script>
</body>
</html>