---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CheckCircle } from 'astro-feather-icons';
import { localePaths } from '../../../config/locales';

export const prerender = true;

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;

// Get contact entry for translations
const contactEntry = await getEntry('contact', 'contact');
const contactData = contactEntry?.data[lang] || contactEntry?.data['fr'];

// Translations for success page
const translations = {
  fr: {
    title: "Message envoyé avec succès",
    heading: "Merci pour votre message !",
    message: "Nous avons bien reçu votre message et nous vous répondrons dans les plus brefs délais.",
    info: "Un membre de notre équipe examinera votre demande et vous contactera sous 24 à 48 heures ouvrables.",
    backToHome: "Retour à l'accueil",
    backToContact: "Envoyer un autre message"
  },
  en: {
    title: "Message Sent Successfully",
    heading: "Thank you for your message!",
    message: "We have received your message and will respond as soon as possible.",
    info: "A member of our team will review your request and contact you within 24 to 48 business hours.",
    backToHome: "Back to Home",
    backToContact: "Send Another Message"
  },
  it: {
    title: "Messaggio inviato con successo",
    heading: "Grazie per il tuo messaggio!",
    message: "Abbiamo ricevuto il tuo messaggio e risponderemo il prima possibile.",
    info: "Un membro del nostro team esaminerà la tua richiesta e ti contatterà entro 24-48 ore lavorative.",
    backToHome: "Torna alla Home",
    backToContact: "Invia un altro messaggio"
  }
};

const t = translations[lang as keyof typeof translations] || translations.fr;

// SEO data
const seoData = {
  title: t.title,
  description: t.message,
  image: contactData?.seo?.image || '/default-social-image.jpg',
  keywords: ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <main class="container mx-auto px-4 py-8 md:py-16">
    <div class="max-w-2xl mx-auto text-center">
      <!-- Success Icon -->
      <div class="mb-6 flex justify-center">
        <div class="bg-green-100 rounded-full p-4">
          <CheckCircle class="w-16 h-16 text-green-600" />
        </div>
      </div>
      
      <!-- Success Heading -->
      <h1 class="text-3xl md:text-4xl font-light mb-4 text-black">{t.heading}</h1>
      
      <!-- Success Message -->
      <p class="text-lg md:text-xl text-gray-700 mb-4">{t.message}</p>
      
      <!-- Additional Info -->
      <p class="text-base text-gray-600 mb-8">{t.info}</p>
      
      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/${lang}/`}
          class="inline-block px-6 py-3 bg-travailleur text-white font-semibold rounded-lg hover:bg-travailleur/90 transform hover:scale-105 transition-all duration-300 shadow-md hover:shadow-lg"
        >
          {t.backToHome}
        </a>
        <a 
          href={`/${lang}/contact/`}
          class="inline-block px-6 py-3 bg-white text-travailleur border-2 border-travailleur font-semibold rounded-lg hover:bg-travailleur/10 transform hover:scale-105 transition-all duration-300 shadow-md hover:shadow-lg"
        >
          {t.backToContact}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>