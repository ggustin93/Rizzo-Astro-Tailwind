---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const privacyEntry = await getEntry('legal', 'privacy');
if (!privacyEntry) {
    throw new Error("Privacy entry not found!");
}
const content = privacyEntry.data[lang as keyof typeof privacyEntry.data] || privacyEntry.data['fr'];
---

<BaseLayout title={content.title} lang={lang} description={content.title}>
  <div class="bg-white md:my-20 p-8">
  <main class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-light mb-12 text-black text-center">{content.title}</h1>
    <div class="space-y-8">
      {content.sections.map((section) => (
        <section>
          <h2 class="text-2xl font-light mb-4 text-black">{section.title}</h2>
          <div 
            class="prose max-w-none prose-p:text-dark-gray prose-p:font-light prose-a:text-blue-600 prose-a:hover:underline"
            set:html={marked.parse(section.text)}
          ></div>
        </section>
      ))}
    </div>
  </main>
  </div>
</BaseLayout>

<style>
  /* Remove redundant prose styles as Tailwind prose classes handle this now */
</style>
