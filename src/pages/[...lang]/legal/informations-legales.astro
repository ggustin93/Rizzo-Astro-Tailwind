---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { marked } from 'marked';
import { localePaths } from '../../../config/locales';

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;
const legalInfoEntry = await getEntry('legal', 'legal-info');
if (!legalInfoEntry) {
  throw new Error("Legal info entry not found!");
}
const content = legalInfoEntry.data[lang as keyof typeof legalInfoEntry.data] || legalInfoEntry.data['fr'];

// Récupérer la configuration du site pour les placeholders
const siteConfigEntry = await getEntry('config', 'site-config');
const lawyers = siteConfigEntry?.data?.lawyers || [];
const address = siteConfigEntry?.data?.address;

if (!lawyers || lawyers.length === 0) {
  throw new Error("FATAL: No lawyers found in site-config.yml for legal pages.");
}

// Use the primary lawyer (Christine Rizzo) for legal pages
const primaryLawyer = lawyers.find((lawyer: any) => lawyer.name === "Christine Rizzo") || lawyers[0];

// Remplacer les placeholders
content.sections.forEach((section: any) => {
  section.text = section.text
    .replace('%%ADDRESS%%', address)
    .replace('%%EMAIL%%', primaryLawyer.email)
    .replace('%%PHONE%%', primaryLawyer.phone);
});

// Ajoutez cette vérification
if (!content) {
  throw new Error(`Content not found for language: ${lang}`);
}

// SEO data
const seoData = {
  title: content.title || `Informations légales - Christine Rizzo`,
  description: `Informations légales et conditions générales de Christine Rizzo, avocate au Barreau de Bruxelles`,
};
---

<BaseLayout title={seoData.title} description={seoData.description} lang={lang}>
  <div class="bg-white md:my-20 p-8">
    <main class="container mx-auto px-4 py-16">
      <h1 class="text-4xl font-light mb-12 text-black text-center">{content.title}</h1>
      <div class="space-y-8">
        {content.sections.map((section: any) => (
          <section>
            <h2 class="text-2xl font-light mb-4 text-black">{section.title}</h2>
            <div 
              class="prose max-w-none prose-p:text-dark-gray prose-p:font-light prose-a:text-blue-600 prose-a:hover:underline"
              set:html={marked.parse(section.text)}
            ></div>
          </section>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  /* Remove redundant prose styles as Tailwind prose classes handle this now */
</style> 