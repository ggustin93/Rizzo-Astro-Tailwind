---
import { getDataEntryById } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CheckCircle, Globe, Briefcase, Mic, Coffee, BookOpen } from 'astro-feather-icons';

export const prerender = true;

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const profileEntry = await getDataEntryById('profile', 'profile');
if (!profileEntry) {
  throw new Error("Profile entry not found! Make sure you have a `profile.yml` file in `src/content/profile`.");
}
const profileData = profileEntry.data[lang] || profileEntry.data['fr']; // Use French as fallback

if (!profileData) {
  throw new Error(`Content not found for language: ${lang}`);
}

// Extract Christine Rizzo's data
const lawyers = profileData.lawyers || [];
const christineLawyer = lawyers.find((lawyer: any) => lawyer.name === "Christine Rizzo");

if (!christineLawyer) {
  throw new Error(`Christine Rizzo not found in profile data for language: ${lang}`);
}

// Translations
const translations = {
  fr: {
    backToTeam: "← Retour à l'équipe",
    languages: "Langues",
    career: "Parcours",
    conferences: "Conférences",
    publications: "Publications",
    with: "avec",
    inCollaborationWith: "En collaboration avec"
  },
  en: {
    backToTeam: "← Back to team",
    languages: "Languages",
    career: "Career",
    conferences: "Conferences",
    publications: "Publications",
    with: "with",
    inCollaborationWith: "In collaboration with"
  },
  it: {
    backToTeam: "← Torna al team",
    languages: "Lingue",
    career: "Percorso",
    conferences: "Conferenze",
    publications: "Pubblicazioni",
    with: "con",
    inCollaborationWith: "In collaborazione con"
  }
};

const t = translations[lang as keyof typeof translations];

// SEO data
const seoData = {
  title: christineLawyer.seo?.title || `Christine Rizzo - Avocate spécialisée en droit du travail`,
  description: christineLawyer.seo?.description || `Christine Rizzo, avocate au Barreau de Bruxelles spécialisée en droit du travail. Expertise pour entreprises et travailleurs.`,
  image: christineLawyer.seo?.image || christineLawyer.image,
  keywords: christineLawyer.seo?.keywords?.join(', ') || 'Christine Rizzo, avocat droit du travail, Bruxelles'
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <div class="bg-white md:my-20 p-4 md:p-8">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
      
      <!-- Back to team link -->
      <div class="mb-8">
        <a 
          href={`/${lang}/equipe/`}
          class="inline-flex items-center text-accent hover:text-travailleur transition-colors duration-300"
        >
          {t.backToTeam}
        </a>
      </div>

      <!-- Image visible only on mobile, above title -->
      <div class="md:hidden mb-8">
        <img src={christineLawyer.image} alt={christineLawyer.name} class="w-full rounded-lg shadow-lg">
      </div>
      
      <div class="flex flex-col md:flex-row gap-8 md:gap-12">
        <div class="w-full md:w-2/3">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-accent mb-4 md:mb-8">{christineLawyer.name}</h1>
          <h2 class="text-2xl md:text-3xl font-light text-black mb-4">{christineLawyer.title}</h2>
          
          {christineLawyer.bio && christineLawyer.bio.map((paragraph: string) => (
            <p class="text-sm md:text-base text-dark-gray mb-4 md:mb-6">{paragraph}</p>
          ))}
          
          <div class="space-y-6 md:space-y-8 mt-6 md:mt-8">
            {christineLawyer.careerPath && (
              <div>
                <h3 class="text-lg md:text-xl font-semibold text-black mb-2 md:mb-3">{t.career}</h3>
                <ul class="space-y-2 mb-4 md:mb-6">
                  {christineLawyer.careerPath.map((item: any) => (
                    <li class="flex flex-col sm:flex-row">
                      <span class="font-semibold text-accent sm:w-24 flex-shrink-0">{item.year}</span>
                      <span class="text-sm md:text-base text-dark-gray">{item.event}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            
            {christineLawyer.languages && (
              <div>
                <h3 class="text-lg md:text-xl font-semibold text-black mb-2 md:mb-3">{t.languages}</h3>
                <p class="text-sm md:text-base text-dark-gray mb-4 md:mb-6">{christineLawyer.languages}</p>
              </div>
            )}
            
            {christineLawyer.conferences && christineLawyer.conferences.length > 0 && (
              <div>
                <h3 class="text-lg md:text-xl font-semibold text-black mb-2 md:mb-4">{t.conferences}</h3>
                <ul class="space-y-2 mb-6 md:mb-8">
                  {christineLawyer.conferences.map((conf: string) => (
                    <li class="text-sm md:text-base text-dark-gray flex items-start">
                      <span class="text-accent mr-2 text-2xl md:text-4xl">•</span> 
                      <span>{conf}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            
            {christineLawyer.publications && christineLawyer.publications.length > 0 && (
              <div>
                <h3 class="text-lg md:text-xl font-semibold text-black mb-2 md:mb-3">{t.publications}</h3>
                <ul class="space-y-3">
                  {christineLawyer.publications.map((pub: any) => (
                    <li class="text-sm md:text-base text-dark-gray flex items-start">
                      <span class="text-accent mr-2 text-2xl md:text-4xl">•</span>
                      <div>
                        <span>{pub.date}:</span> "{pub.title}", {pub.publisher}
                        {pub.coAuthors && <span class="italic"> ({t.inCollaborationWith} {pub.coAuthors.join(', ')})</span>}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
        
        <!-- Image visible only on desktop -->
        <div class="hidden md:block md:w-1/3">
          <img src={christineLawyer.image} alt={christineLawyer.name} class="w-full rounded-lg shadow-lg">
        </div>
      </div>
    </div>
  </div>
</BaseLayout>