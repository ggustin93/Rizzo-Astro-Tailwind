---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ChevronRight, Search, FileText, UserPlus, Shield, ArrowRight } from 'astro-feather-icons2';
import IconHandshake from '../../../components/IconHandshake.astro';

// Translations
const translations = {
  fr: {
    backLinkText: "Retour aux services"
  },
  en: {
    backLinkText: "Back to services"
  },
  it: {
    backLinkText: "Torna ai servizi"
  }
};

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const employeursEntry = await getEntry('employeurs', 'employeurs');
const content = employeursEntry.data[lang] || employeursEntry.data['fr']; // Use French as fallback

if (!content) {
  throw new Error(`Content not found for language: ${lang}`);
}

const t = translations[lang as keyof typeof translations];

const iconMap = {
  Search,
  FileText,
  UserPlus,
  Handshake: IconHandshake,
  Shield
};

// SEO data
const seoData = {
  title: content.seo?.title || `Services pour employeurs - Christine Rizzo`,
  description: content.seo?.description || content.description,
  image: content.seo?.image || 'https://v5--crizzo.netlify.app/_astro/logo_crizzo_calli3.8EyI_Q3S_2joHla.svg',
  keywords: content.keywords?.join(', ') || content.seo?.keywords || ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}>
  
  <div class="bg-white md:my-20 p-4 md:p-8 rounded-lg">
    <main class="container mx-auto px-3 md:px-4 pt-6 md:pt-8 pb-12 md:pb-16">
      <h1 class="text-3xl md:text-4xl font-light mb-8 md:mb-12 text-black text-center">{content.title}</h1>
      
      <div class="flex flex-col md:flex-row gap-6 md:gap-8">
        <!-- Left Column (2/3) -->
        <div class="md:w-2/3 bg-employeur p-5 md:p-8 rounded-lg text-white">
          <ul class="space-y-2 mb-6">
            {content.questions.map((question: string, index: number) => (
              <li set:key={index} class="flex items-start">
                <ChevronRight class="w-5 h-5 mr-2 text-white flex-shrink-0 mt-1" />
                <span class="text-sm md:text-base">{question}</span>
              </li>
            ))}
          </ul>
          
          {content.additionalSupport && (
            <div class="mt-6 md:mt-8 text-white">
              <p class="text-sm md:text-base">
                {content.additionalSupport.intro}
                <ul class="pl-5 my-2 md:my-3 space-y-1">
                  {content.additionalSupport.points.map((point: string, index: number) => (
                    <li set:key={index} class="flex items-start">
                      <ChevronRight class="w-5 h-5 mr-2 text-white flex-shrink-0 mt-1" />
                      <span class="text-sm md:text-base">{point}</span>
                    </li>
                  ))}
                </ul>
                {content.additionalSupport.conclusion}
              </p>
            </div>
          )}
        </div>
        
        <!-- Right Column (1/3) -->
        <div class="md:w-1/3 bg-white p-5 md:p-8 rounded-lg shadow-sm md:shadow-none">
          <h2 class="text-xl md:text-2xl font-light mb-4 md:mb-6 text-black">{content.servicesTitle}</h2>
          <ul class="space-y-4 md:space-y-6">
            {content.services.map((service: any, index: number) => {
              const IconComponent = iconMap[service.icon as keyof typeof iconMap];
              return (
                <li set:key={index} class="flex items-start">
                  <IconComponent class="w-6 h-6 md:w-8 md:h-8 mr-3 md:mr-4 text-employeur flex-shrink-0" />
                  <span class="text-dark-gray font-light text-sm md:text-base">{service.text}</span>
                </li>
              );
            })}
          </ul>
          <div class="mt-8 md:mt-12 text-center">
            <a href={`/${lang}/honoraires`} class="inline-flex items-center text-employeur hover:underline text-sm md:text-base">
              {content.ctaText}
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>