---
import { getDataEntryById } from 'astro:content';
import BelgianServices from '../../../components/BelgianServices.astro';
import { localePaths } from '../../../config/locales';
export const prerender = true;
export const getStaticPaths = localePaths;
const { lang } = Astro.params;
const entry = await getDataEntryById('employeurs', 'employeurs');
if (!entry) throw new Error('Missing employeurs content');
const content = entry.data[lang] || entry.data.fr;
---
<BelgianServices content={content} lang={lang} audience="employeurs" />
