---
import { getDataEntryById } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';
import { ChevronRight, ArrowRight, ArrowDown, Briefcase, Shield, FileText, CheckSquare, User } from 'astro-feather-icons2';
import IconHandshake from '../../../components/IconHandshake.astro';

export const prerender = true;

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;

const europeennesEntry = await getDataEntryById('europeennes', 'europeennes');
if (!europeennesEntry) {
    throw new Error("Europeennes service entry not found! Make sure you have `europeennes.yml` in `src/content/europeennes`");
}
const content = europeennesEntry.data[lang] || europeennesEntry.data['fr'];

if (!content) {
  throw new Error(`Content not found for language: ${lang}`);
}

const iconMap = {
  FileText,
  Handshake: IconHandshake,
  BriefCase: Briefcase,
  Shield,
  CheckSquare
};

// SEO data
const keywords = Array.isArray(content.seo?.keywords) ? content.seo.keywords.join(', ') : '';

const seoData = {
  title: content.seo?.title || `Services pour les institutions européennes - Christine Rizzo`,
  description: content.seo?.description || '',
  image: content.seo?.image || '/default-social-image.jpg',
  keywords: keywords
};
---

<BaseLayout
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}>

  <div class="bg-white md:my-20 p-4 md:p-8 rounded-lg">
    <main class="container mx-auto px-3 md:px-4 pt-6 md:pt-8 pb-12 md:pb-16">

      <!-- H1 -->
      <h1 class="text-3xl md:text-4xl font-light mb-8 md:mb-12 text-black text-center">{content.title}</h1>

      <!-- Navigation Cards -->
      <div class="flex flex-col sm:flex-row items-stretch gap-4 md:gap-6 mb-12 md:mb-16 max-w-4xl mx-auto">
        <a href="#agences" class="flex-1 bg-europeenne/5 border border-europeenne text-europeenne hover:bg-europeenne hover:text-white rounded-lg px-4 py-4 md:py-5 flex items-center justify-center gap-2 text-center transition-colors duration-200 group whitespace-nowrap">
          <Briefcase class="w-5 h-5 flex-shrink-0 opacity-80" />
          <span class="text-sm md:text-base font-light">{content.navigationCards.agences}</span>
          <ArrowDown class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity flex-shrink-0" />
        </a>
        <a href="#fonctionnaires" class="flex-1 bg-europeenne/5 border border-europeenne text-europeenne hover:bg-europeenne hover:text-white rounded-lg px-4 py-4 md:py-5 flex items-center justify-center gap-2 text-center transition-colors duration-200 group whitespace-nowrap">
          <User class="w-5 h-5 flex-shrink-0 opacity-80" />
          <span class="text-sm md:text-base font-light">{content.navigationCards.fonctionnaires}</span>
          <ArrowDown class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity flex-shrink-0" />
        </a>
      </div>

      <!-- Section Agences -->
      <section id="agences" class="scroll-mt-24 mb-12 md:mb-16 pt-4 border-t border-gray-100">
        <h2 class="text-2xl md:text-3xl font-light mb-6 text-black">{content.agences.accompagnementTitle}</h2>
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <!-- Left Column (2/3) -->
          <div class="md:w-2/3 bg-europeenne p-6 md:p-10 rounded-lg text-white flex flex-col justify-start">
            <p class="text-sm md:text-base leading-relaxed mb-6 opacity-90">{content.agences.intro}</p>
            <div class="space-y-6 md:space-y-8 py-2 md:py-4">
              {content.agences.accompagnement.map((group: any, index: number) => (
                <div set:key={index}>
                  <h3 class="text-base md:text-lg font-semibold mb-3 text-white">{group.title}</h3>
                  <ul class="space-y-2 md:space-y-3 ml-2">
                    {group.items.map((item: string, i: number) => (
                      <li set:key={i} class="flex items-start">
                        <ChevronRight class="w-5 h-5 mr-3 text-white flex-shrink-0 mt-0.5" />
                        <span class="text-sm md:text-base leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- Right Column (1/3) -->
          <div class="md:w-1/3 bg-white p-5 md:p-8 rounded-lg shadow-sm md:shadow-none">
            <h3 class="text-xl md:text-2xl font-light mb-4 md:mb-6 text-black">{content.agences.servicesTitle}</h3>
            <ul class="space-y-4 md:space-y-6">
              {content.agences.services.map((service: any, index: number) => {
                const IconComponent = iconMap[service.icon as keyof typeof iconMap];
                return (
                  <li set:key={index} class="flex items-start">
                    {IconComponent && <IconComponent class="w-5 h-5 mr-3 text-europeenne flex-shrink-0 mt-0.5" />}
                    <span class="text-dark-gray font-light text-sm md:text-base">{service.text}</span>
                  </li>
                );
              })}
            </ul>
            <div class="mt-8 md:mt-12 text-center">
              <a href={`/${lang}/honoraires`} class="inline-flex items-center text-europeenne hover:underline text-sm md:text-base">
                {content.ctaText}
                <ArrowRight class="w-4 h-4 ml-2" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section Fonctionnaires -->
      <section id="fonctionnaires" class="scroll-mt-24 pt-4 border-t border-gray-100">
        <h2 class="text-2xl md:text-3xl font-light mb-6 text-black">{content.fonctionnaires.accompagnementTitle}</h2>
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <!-- Left Column (2/3) -->
          <div class="md:w-2/3 bg-europeenne/10 border border-europeenne/20 p-6 md:p-10 rounded-lg flex flex-col justify-start">
            <p class="text-sm md:text-base leading-relaxed mb-6 text-dark-gray">{content.fonctionnaires.intro}</p>
            <ul class="space-y-3 md:space-y-5 mx-auto py-2 md:py-4">
              {content.fonctionnaires.accompagnement.map((item: string, index: number) => (
                <li set:key={index} class="flex items-start">
                  <ChevronRight class="w-5 h-5 mr-3 text-europeenne flex-shrink-0 mt-1" />
                  <span class="text-sm md:text-base leading-relaxed text-dark-gray">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Right Column (1/3) -->
          <div class="md:w-1/3 bg-white p-5 md:p-8 rounded-lg shadow-sm md:shadow-none">
            <h3 class="text-xl md:text-2xl font-light mb-4 md:mb-6 text-black">{content.fonctionnaires.servicesTitle}</h3>
            <ul class="space-y-4 md:space-y-6">
              {content.fonctionnaires.services.map((service: any, index: number) => {
                const IconComponent = iconMap[service.icon as keyof typeof iconMap];
                return (
                  <li set:key={index} class="flex items-start">
                    {IconComponent && <IconComponent class="w-5 h-5 mr-3 text-europeenne flex-shrink-0 mt-0.5" />}
                    <span class="text-dark-gray font-light text-sm md:text-base">{service.text}</span>
                  </li>
                );
              })}
            </ul>
            <div class="mt-8 md:mt-12 text-center">
              <a href={`/${lang}/honoraires`} class="inline-flex items-center text-europeenne hover:underline text-sm md:text-base">
                {content.ctaText}
                <ArrowRight class="w-4 h-4 ml-2" />
              </a>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>


</BaseLayout>
