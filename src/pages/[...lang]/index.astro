---
import { getEntry, getDataEntryById } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../config/locales';
import CTA from '../../components/CTA.astro';
import { ChevronDown, Briefcase, User, FileText, Globe, ArrowRight } from 'astro-feather-icons2';
import { Calendar } from 'astro-feather-icons';
import { getArticles } from '../../utils/articles';
import { getTeam, profilePath } from '../../utils/team.js';
import ArticleCard from '../../components/ArticleCard.astro';
import Button from '../../components/Button.astro';
// Import des images locales



const supportedLanguages = LOCALES;
type SupportedLanguage = typeof supportedLanguages[number];

export interface Props {
  currentLang: SupportedLanguage;
}

export async function getStaticPaths() {
  return LOCALES.map(lang => ({
    params: { lang },
    props: { currentLang: lang as SupportedLanguage }
  }));
}

const { lang: rawLangParam } = Astro.params;

if (typeof rawLangParam !== 'string' || !supportedLanguages.includes(rawLangParam as SupportedLanguage)) {
  console.warn(`Paramètre de langue invalide ou non supporté dans l'URL: '${rawLangParam}'. Redirection vers /fr/.`);
  return Astro.redirect('/fr/', 302);
}

const { currentLang } = Astro.props;
import { getUiTranslations } from '../../utils/ui-translations';
const uiTranslations = await getUiTranslations(currentLang);

const homeEntry = await getDataEntryById('home', 'home');
if (!homeEntry) {
  throw new Error("Home entry not found! Make sure you have a `home.yml` file in `src/content/home`.");
}
const content = homeEntry.data[currentLang] || homeEntry.data['fr'];
const { media, portraitLinks, serviceOrder } = homeEntry.data;
const serviceColors = { employeurs: 'service-employer', travailleurs: 'service-worker', europeennes: 'service-europe' };
const serviceIcons = { employeurs: Briefcase, travailleurs: User, europeennes: Globe };

// Les avocates, leurs photos et leurs slugs sont résolus centralement pour que
// les liens de la home ne puissent pas diverger des routes de [slug].astro.
const lawyersWithImages = await getTeam(currentLang);

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
if (!siteConfigEntry) {
  throw new Error("Site config entry not found in index page! Make sure you have a `site-config.md` file in `src/content/config`.");
}
const showArticlesSection = siteConfigEntry?.data?.sectionsVisibility || false;
if (!content || !content.expertise || !content.expertise.travailleurs) {
  console.error('Structure de contenu invalide:', content);
}

// Récupération des articles
const recentArticles = showArticlesSection ? await getArticles(currentLang, 3) : [];

// Ajout des métadonnées SEO
const { title, description, keywords, image } = content.seo;

export const prerender = true;
---

<BaseLayout title={title} description={description} keywords={keywords} image={image} lang={currentLang}>  
  <div class="full-bleed bg-white bg-svg-pattern">
    <section class="home-hero">
      <div class="container hero-layout">
        <div class="hero-copy">
          <h1 class="hero-title">{content.hero.title}</h1>
          <h2 class="hero-subtitle">{content.hero.subtitle}</h2>
          <p class="hero-description">{content.hero.description}</p>
          <div class="hero-actions">
            <Button 
              href={`/${currentLang}${content.hero.destination}`}
              text={content.hero.cta}
              variant="primary"
              icon={Calendar}
              iconPosition="left"
              ariaLabel={content.hero.cta}
              class="hero-primary"
            />
            <Button 
              variant="secondary"
              icon={ChevronDown}
              href="#expertise"
              class="hero-secondary"
            >
              <span class="whitespace-nowrap">{content.hero.more}</span>
            </Button>
          </div>
        </div>
        <div class="hero-art">
          <img 
            src={media.hero}
            alt={content.hero.imageAlt}
            class="hero-illustration"
            decoding="async" 
            loading="eager" 
            width="950" 
            height="750"
          />
        </div>
      </div>
    </section>
  </div>

  <div class="full-bleed bg-beige">
    <section id="expertise" class="py-10 md:py-14">
      <div class="container px-4">
        <div class="flex items-center mb-4 md:mb-6 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-2xl sm:text-3xl font-light text-gray-800 mx-4 md:mx-8 text-center flex items-center">
            {content.expertise.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        
        <p class="text-center mb-6 md:mb-8 max-w-3xl mx-auto text-dark-gray text-base md:text-lg font-light">
          {content.expertise.description}
        </p> 
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-0">
          {serviceOrder.map(key => {
            const service = content.expertise[key];
            const ServiceIcon = serviceIcons[key];
            return (
              <div class={`service-card ${serviceColors[key]} p-6 md:p-8 rounded-lg flex flex-col justify-between`}>
                <div>
                  <ServiceIcon aria-hidden="true" title="" class="service-icon w-8 h-8 mb-6" />
                  <h3 class="text-lg md:text-xl font-semibold mb-3 md:mb-4">{service.title}</h3>
                  <p class="text-base md:text-lg font-light mb-4">{service.description}</p>
                </div>
                <Button href={`/${currentLang}${service.destination}`} text={service.cta} icon={ArrowRight} variant="secondary"
                  class="self-start mt-4 border-current hover:bg-beige" />
              </div>
            );
          })}
        </div>

      </div>
    </section>
  </div>
  
  <div class="full-bleed bg-white">
    <section id="profil" class="py-16 md:py-24 bg-svg-pattern">
      <div class="container mx-auto px-4">
        <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-2xl sm:text-3xl font-light text-gray-800 mx-4 md:mx-8 text-center flex items-center">
            <User class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
            {content.profil.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        <img src={media.team} alt={content.profil.imageAlt} class="w-full h-auto max-w-2xl mx-auto mb-8" width="1200" height="600" loading="lazy" />
        <div class="max-w-5xl mx-auto text-center">
          <p class="text-dark-gray text-base md:text-lg font-light leading-relaxed mb-6 max-w-3xl mx-auto">{content.profil.description}</p>
          <p class="text-lg font-medium text-gray-800 mb-8">{content.profil.cta}</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            {lawyersWithImages.map(lawyer => {
              const Tag = portraitLinks === 'profiles' ? 'a' : 'div';
              return (
                <Tag href={portraitLinks === 'profiles' ? profilePath(currentLang, lawyer) : undefined} class="block rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
                  <img src={lawyer.image} alt={lawyer.imageAlt || lawyer.name} width="500" height="500" loading="lazy" decoding="async"
                    class="aspect-square w-full max-w-[180px] mx-auto object-cover rounded-xl mb-4" />
                  <h3 class="text-base md:text-lg font-semibold text-gray-800">{lawyer.name}</h3>
                </Tag>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </div>

  <CTA />

  {showArticlesSection && (
    <div id="articles" class="full-bleed bg-beige">
      <section class="py-16 md:py-24">
        <div class="container mx-auto px-4">
          <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
            <h2 class="text-2xl sm:text-3xl font-light text-gray-800 mx-4 md:mx-8 text-center flex items-center">
              <FileText class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
              {content.articlesTitle}
            </h2>
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recentArticles.map((article) => (
              <ArticleCard 
                article={article}
                lang={currentLang}
                url={`/${currentLang}/blog/${article.slug.split('/')[1] || ''}`}
                uiTranslations={uiTranslations}
              />
            ))}
          </div>
          <div class="text-center mt-12">
            <Button 
              href={`/${currentLang}/blog`} 
              text={`${content.viewAllArticles} →`}
              variant="secondary"
              class="uppercase text-sm font-light hover:text-gray-900"
            />
          </div>
        </div>
      </section>
    </div>
  )}

</BaseLayout>

<style>
  .home-hero { padding-block: clamp(2.5rem, 5vw, 5rem); }
  .hero-layout { display: grid; align-items: center; gap: 2.5rem; }
  .hero-copy { min-width: 0; }
  .hero-title { color: #263952; font-size: clamp(2rem, 3.6vw, 3.25rem); font-weight: 400; line-height: 1.12; letter-spacing: -.025em; margin-bottom: 1.5rem; }
  .hero-subtitle { color: #70685f; font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 400; line-height: 1.35; text-wrap: balance; max-width: 27ch; }
  .hero-subtitle::after { content: ""; display: block; width: 4rem; height: 4px; background: #ffcc33; border-radius: 2px; margin-block: 1.5rem; }
  .hero-description { color: #4b5158; max-width: 47ch; font-size: 1.0625rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.75rem; }
  .hero-actions :global(a) { min-height: 44px; padding: .7rem 1.1rem; border-radius: .5rem; }
  .hero-actions :global(.hero-primary) { background: var(--worker-ink); border-color: var(--worker-ink); color: white; }
  .hero-actions :global(.hero-primary:hover) { background: #055f6b; }
  .hero-actions :global(.hero-secondary) { border-color: #b1b7bc; background: white; color: #333; }
  .hero-actions :global(.hero-secondary:hover) { background: #faf5f0; border-color: #68727b; }
  .hero-art { display: flex; justify-content: center; }
  .hero-illustration { width: 100%; height: auto; max-width: 32rem; object-fit: contain; }
  @media (min-width: 1024px) {
    .hero-layout { grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .home-hero { padding-block: 2.5rem 3rem; }
    .hero-layout { grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr); gap: 1.75rem; }
    .hero-title { font-size: clamp(1.65rem, 3.6vw, 2.25rem); margin-bottom: 1rem; }
    .hero-subtitle { font-size: clamp(1.2rem, 2.5vw, 1.6rem); line-height: 1.4; text-wrap: pretty; }
    .hero-subtitle::after { width: 3rem; margin-block: 1rem; height: 3px; }
    .hero-description { font-size: .96rem; line-height: 1.65; }
    .hero-actions { gap: .65rem; margin-top: 1.25rem; }
    .hero-actions :global(a) { font-size: .75rem; padding: .7rem .8rem; }
    .hero-illustration { max-width: 18rem; }
    #expertise .grid { gap: 1rem; }
    .service-card { padding: 1.2rem; }
    .service-card h3 { font-size: 1.05rem; }
    .service-card p { font-size: .95rem; }
    .service-card .service-icon { margin-bottom: 1rem; }
  }
  @media (max-width: 639px) {
    .home-hero { padding-block: 1.75rem 2rem; }
    .hero-layout { gap: 1rem; }
    .hero-copy { text-align: center; }
    .hero-subtitle, .hero-description { margin-inline: auto; }
    .hero-subtitle::after { margin-inline: auto; }
    .hero-actions { width: 100%; max-width: 22rem; margin-inline: auto; }
    .hero-title { font-size: clamp(1.6rem, 6.7vw, 2rem); margin-bottom: .85rem; }
    .hero-subtitle { font-size: clamp(1.15rem, 4.9vw, 1.45rem); line-height: 1.45; max-width: 32ch; text-wrap: pretty; }
    .hero-subtitle::after { width: 2.75rem; height: 3px; margin-block: 1rem; }
    .hero-description { max-width: 40ch; font-size: 1rem; line-height: 1.65; }
    .hero-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: .65rem; margin-top: 1.25rem; }
    .hero-actions :global(a) { min-width: 0; min-height: 48px; padding: .75rem .5rem; font-size: .8125rem; line-height: 1.35; text-align: center; }
    .hero-actions :global(span) { white-space: nowrap; }
    .hero-actions :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
    .hero-illustration { max-width: 13.2rem; }
  }
  #profil a img { transition: opacity .15s; }
  #profil a:hover img { opacity: .85; }
  .service-card { background: white; border: 1px solid #e0e3e5; border-top: 4px solid var(--service-color); color: #333; }
  .service-employer { --service-color: var(--employer-brand); }
  .service-worker { --service-color: var(--worker-brand); }
  .service-europe { --service-color: var(--europe-brand); }
  .service-card h3 { color: #263952; line-height: 1.4; }
  .service-icon { color: var(--service-color); }
  #expertise { scroll-margin-top: 6rem; }
  :global(main a:focus-visible), :global(main button:focus-visible) { outline: 2px solid var(--worker-ink); outline-offset: 4px; }
</style>
