---
import { getEntry, getDataEntryById } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { ChevronDown, Briefcase, User, FileText } from 'astro-feather-icons2';
import { Calendar } from 'astro-feather-icons';
import { getArticles } from '../../utils/articles';
import ArticleCard from '../../components/ArticleCard.astro';
import Button from '../../components/Button.astro';
// Import des images locales
import heroImage from '../../assets/images/hero_image_wbg.svg';
import illustrationServices from '../../assets/images/illustration_services.svg';

const supportedLanguages = ['fr', 'en', 'it'] as const;
type SupportedLanguage = typeof supportedLanguages[number];

export interface Props {
  currentLang: SupportedLanguage;
}

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({
    params: { lang },
    props: { currentLang: lang as SupportedLanguage }
  }));
}

const { lang: rawLangParam } = Astro.params;

if (typeof rawLangParam !== 'string' || !supportedLanguages.includes(rawLangParam as SupportedLanguage)) {
  console.warn(`Paramètre de langue invalide ou non supporté dans l'URL: '${rawLangParam}'. Redirection vers /fr/.`);
  return Astro.redirect('/fr/', 302);
}

const { currentLang } = Astro.props;
import { getUiTranslations } from '../../utils/ui-translations';
const uiTranslations = await getUiTranslations(currentLang);

const homeEntry = await getDataEntryById('home', 'home');
if (!homeEntry) {
  throw new Error("Home entry not found! Make sure you have a `home.yml` file in `src/content/home`.");
}
const content = homeEntry.data[currentLang] || homeEntry.data['fr'];

// Récupérer les données des profils pour les photos CMS
const profileEntry = await getDataEntryById('profile', 'profile');
if (!profileEntry) {
  throw new Error("Profile entry not found! Make sure you have a `profile.yml` file in `src/content/profile`.");
}
const profileData = profileEntry.data[currentLang] || profileEntry.data['fr'];
const teamImages = profileEntry.data.teamImages || [];

// Mapper les photos aux avocates par nom
const lawyers = profileData.lawyers || [];
const lawyersWithImages = lawyers.map(lawyer => {
  const imageData = teamImages.find(img => img.name === lawyer.name);
  return {
    ...lawyer,
    image: imageData ? imageData.image : null
  };
});

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
if (!siteConfigEntry) {
  throw new Error("Site config entry not found in index page! Make sure you have a `site-config.md` file in `src/content/config`.");
}
const showArticlesSection = siteConfigEntry?.data?.sectionsVisibility || false;
if (!content || !content.expertise || !content.expertise.travailleurs) {
  console.error('Structure de contenu invalide:', content);
}

// Récupération des articles
const recentArticles = showArticlesSection ? await getArticles(currentLang, 3) : [];

// Ajout des métadonnées SEO
const { title, description, keywords, image } = content.seo;

export const prerender = true;
---

<BaseLayout title={title} description={description} keywords={keywords} image={image} lang={currentLang}>  
  <div class="full-bleed bg-white bg-svg-pattern">
    <section class="py-6 md:py-10 relative">
      <div class="container mx-auto px-4 flex flex-col items-center md:flex-row md:items-center md:justify-between">
        <div class="w-full md:w-1/2 text-center md:text-left">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-light mb-2 md:mb-3 text-gray-800 leading-tight">{content.hero.title.replace(' et ', ' & ')}</h1>
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl mb-3 md:mb-4 text-accent font-light leading-snug">{content.hero.subtitle}</h2>
          <p class="mb-5 md:mb-6 text-base md:text-lg text-dark-gray max-w-xl mx-auto md:mx-0 font-light leading-relaxed">{content.hero.description}</p>
          <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start space-y-3 sm:space-y-0 sm:space-x-4">
            <Button 
              href={`/${currentLang}/contact`}
              text={content.hero.cta}
              variant="primary"
              icon={Calendar}
              iconPosition="left"
              ariaLabel="Prendre rendez-vous"
              class="bg-accent text-white font-medium hover:bg-travailleur text-center justify-center"
            />
            <Button 
              variant="secondary"
              icon={ChevronDown}
              onClick="document.getElementById('expertise').scrollIntoView({behavior: 'smooth'})"
              class="border-gray-400 hover:bg-beige hover:text-gray-900 text-center justify-center"
            >
              <span class="whitespace-nowrap">{content.expertise.travailleurs.cta}</span>
            </Button>
          </div>
        </div>
        <div class="w-full md:w-1/2 flex justify-center md:justify-end mt-6 md:mt-0">
          <img 
            src={heroImage.src} 
            alt="Christine Rizzo et Stephanie Michiels"
            class="w-full h-auto max-w-sm md:max-w-xl object-contain" 
            decoding="async" 
            loading="eager" 
            width="950" 
            height="750"
          />
        </div>
      </div>
    </section>
  </div>

  <div class="full-bleed bg-beige">
    <section id="expertise" class="py-10 md:py-14">
      <div class="container px-4">
        <div class="flex items-center mb-4 md:mb-6 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
            <Briefcase class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
            {content.expertise.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        
        <p class="text-center mb-6 md:mb-8 max-w-3xl mx-auto text-dark-gray text-base md:text-lg font-light">
          {content.expertise.description}
        </p> 
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-0">
          <!-- BLOC 1 : EMPLOYEURS -->
          <div class="bg-employeur p-4 md:p-6 rounded-lg text-white flex flex-col justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-semibold mb-3 md:mb-4">{content.expertise.employeurs.title}</h3>
              <p class="text-base md:text-lg font-light mb-4">{content.expertise.employeurs.description}</p>
            </div>
            <Button
              href={`/${currentLang}/services/employeurs`}
              text={`${content.expertise.employeurs.cta} →`}
              variant="secondary"
              class="self-end bg-white text-gray-900 hover:bg-transparent hover:text-white border-white"
            />
          </div>
          <!-- BLOC 2 : TRAVAILLEURS -->
          <div class="bg-travailleur p-4 md:p-6 rounded-lg text-white flex flex-col justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-semibold mb-3 md:mb-4">{content.expertise.travailleurs.title}</h3>
              <p class="text-base md:text-lg font-light mb-4">{content.expertise.travailleurs.description}</p>
            </div>
            <Button
              href={`/${currentLang}/services/travailleurs`}
              text={`${content.expertise.travailleurs.cta} →`}
              variant="secondary"
              class="self-end bg-white text-gray-900 hover:bg-transparent hover:text-white border-white"
            />
          </div>
          <!-- BLOC 3 : INSTITUTIONS EUROPÉENNES -->
          <div class="bg-europeenne p-4 md:p-6 rounded-lg text-white flex flex-col justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-semibold mb-1 md:mb-2">{content.expertise.europeennes.title}</h3>
              {content.expertise.europeennes.subtitle && (
                <p class="text-xs md:text-sm font-light opacity-75 mb-3 uppercase tracking-wide">{content.expertise.europeennes.subtitle}</p>
              )}
              <p class="text-base md:text-lg font-light mb-4">{content.expertise.europeennes.description}</p>
            </div>
            <Button
              href={`/${currentLang}/services/europeennes`}
              text={`${content.expertise.europeennes.cta} →`}
              variant="secondary"
              class="self-end bg-white text-gray-900 hover:bg-transparent hover:text-white border-white"
            />
          </div>
        </div>

        <img 
          src={illustrationServices.src} 
          alt="Illustration des services" 
          class="w-full max-w-3xl md:max-w-4xl mx-auto mb-8"
          width="1200"
        />
        
      </div>
    </section>
  </div>
  
  <div class="full-bleed bg-white">
    <section id="profil" class="py-16 md:py-24 bg-svg-pattern">
      <div class="container mx-auto px-4">
        <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
            <User class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
            {content.profil.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        <div class="max-w-2xl mx-auto">
          <!-- Photo montage of both lawyers using CMS images -->
          <div class="grid grid-cols-2 gap-4 md:gap-6 mb-8">
            {lawyersWithImages.map((lawyer) => (
              <div class="text-center">
                <a href={`/${currentLang}/equipe/${lawyer.name.toLowerCase().replace(' ', '-')}`} class="block group">
                  <div class="aspect-square overflow-hidden rounded-lg shadow-lg mb-3 border border-gray-900 relative max-w-[200px] md:max-w-[250px] mx-auto">
                    {lawyer.image ? (
                      <img 
                        src={lawyer.image} 
                        alt={lawyer.name} 
                        class="w-full h-full object-cover object-center transition-all duration-300 group-hover:scale-105" 
                        decoding="async" 
                        loading="lazy" 
                        height="500"
                        width="500" 
                      />
                    ) : (
                      <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                        <span class="text-gray-500">Photo à venir</span>
                      </div>
                    )}
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition-all duration-300"></div>
                  </div>
                  <h3 class="text-base md:text-lg font-semibold text-travailleur group-hover:text-travailleur/80 transition-colors">{lawyer.name}</h3>
                </a>
              </div>
            ))}
          </div>
          <!-- Description and CTA -->
          <div class="text-center">
            <p class="text-dark-gray text-base md:text-lg font-light leading-relaxed mb-6 max-w-3xl mx-auto">{content.profil.description}</p>
            <Button
                href={`/${currentLang}/equipe`}
                text={`${content.profil.cta} →`}
                variant="secondary"
                class="uppercase text-sm font-light hover:text-gray-900"
              />
          </div>
        </div>
      </div>
    </section>
  </div>

  <CTA lang={currentLang} uiTranslations={uiTranslations} />

  {showArticlesSection && (
    <div id="articles" class="full-bleed bg-beige">
      <section class="py-16 md:py-24">
        <div class="container mx-auto px-4">
          <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
            <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
              <FileText class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
              {content.articlesTitle}
            </h2>
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recentArticles.map((article) => (
              <ArticleCard 
                article={article}
                lang={currentLang}
                url={`/${currentLang}/blog/${article.slug.split('/')[1] || ''}`}
                uiTranslations={uiTranslations}
              />
            ))}
          </div>
          <div class="text-center mt-12">
            <Button 
              href={`/${currentLang}/blog`} 
              text={`${content.viewAllArticles} →`}
              variant="secondary"
              class="uppercase text-sm font-light hover:text-gray-900"
            />
          </div>
        </div>
      </section>
    </div>
  )}

</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollBtn = document.querySelector('.scroll-btn');
    if (scrollBtn) {
      scrollBtn.addEventListener('click', () => {
        const servicesSection = document.getElementById('services');
        if (servicesSection) {
          servicesSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  });
</script>