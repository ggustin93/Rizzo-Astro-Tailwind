---
// src/pages/blog/[lang]/[slug].astro
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { CheckCircle } from 'astro-feather-icons';
import { ChevronDown, Briefcase, User, FileText } from 'astro-feather-icons2';
import { Calendar } from 'astro-feather-icons';
import { getArticles } from '../../utils/articles';
import ArticleCard from '../../components/ArticleCard.astro';
import { Picture, Image } from 'astro:assets';
import SEO from '../../components/SEO.astro';
import Button from '../../components/Button.astro';

// Import des images locales
import heroImage from '../../assets/images/hero_image_wbg.svg';
import profileImage from '../../assets/images/chrizzo-pp.avif';
import illustrationServices from '../../assets/images/illustration_services.svg';

const supportedLanguages = ['fr', 'en', 'it'] as const;
type SupportedLanguage = typeof supportedLanguages[number];

export interface Props {
  currentLang: SupportedLanguage;
}

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { currentLang } = Astro.props as Props;
import { getUiTranslations } from '../../utils/ui-translations';
const uiTranslations = await getUiTranslations(currentLang);

const { lang } = Astro.params;
const homeEntry = await getEntry('home', 'home');
const content = homeEntry.data[lang as keyof typeof homeEntry.data] || homeEntry.data['fr'];

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const showArticlesSection = siteConfigEntry?.data?.sectionsVisibility || false;
const calendarLink = siteConfigEntry?.data?.calendarLink || 'https://cal.com/c.rizzo-avocat.be/rendez-vous?duration=15';

if (!content || !content.expertise || !content.expertise.travailleurs) {
  console.error('Structure de contenu invalide:', content);
}

// Récupération des articles
const recentArticles = showArticlesSection ? await getArticles(lang, 3) : [];

// Ajout des métadonnées SEO
const { title, description, keywords, image } = content.seo;

// Fonction pour générer des IDs uniques
function generateUniqueId(prefix: string) {
  return `${prefix}-${Math.random().toString(36).substr(2, 9)}`;
}
---

<BaseLayout title={title} description={description} keywords={keywords} image={image} lang={currentLang}>  
  <div class="full-bleed bg-white bg-svg-pattern">
    <section class="py-6 md:py-10 relative">
      <div class="container mx-auto px-4 flex flex-col items-center md:flex-row md:items-center md:justify-between">
        <div class="w-full md:w-1/2 text-center md:text-left">
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light mb-2 md:mb-3 text-gray-800">{content.hero.title}</h1>
          <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl mb-3 md:mb-4 text-accent font-light">{content.hero.subtitle}</h2>
          <p class="mb-5 md:mb-6 text-sm md:text-base text-dark-gray max-w-xl mx-auto md:mx-0 font-light leading-relaxed">{content.hero.description}</p>
          <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start space-y-3 sm:space-y-0 sm:space-x-4">
            <Button 
              text={content.hero.cta}
              variant="primary"
              icon={Calendar}
              iconPosition="left"
              ariaLabel="Call to action"
              dataAttr={{
                "cal-link": calendarLink.replace('https://cal.com/', ''),
                "cal-config": '{"layout":"month_view"}'
              }}
              class="w-full sm:w-auto min-w-[200px] bg-accent text-white font-medium hover:bg-accent/90 hover:text-black"
            />
            <Button 
              variant="secondary"
              icon={ChevronDown}
              onClick="document.getElementById('expertise').scrollIntoView({behavior: 'smooth'})"
              class="w-full sm:w-auto min-w-[120px] border-gray-400 hover:bg-gray-100"
            >
              <span class="hidden sm:inline">{content.expertise.travailleurs.cta}</span><span class="sm:hidden">{content.expertise.travailleurs.cta}</span>
            </Button>
          </div>
        </div>
        <div class="w-full md:w-1/2 flex justify-center md:justify-end mt-6 md:mt-0">
          <Picture 
            src={heroImage} 
            formats={['avif', 'webp']} 
            alt="Christine Rizzo" 
            class="w-full h-auto max-w-sm md:max-w-xl object-contain" 
            decoding="async" 
            loading="eager" 
            width="950" 
            height="750"
          />
        </div>
      </div>
    </section>
  </div>

  <div class="full-bleed bg-beige">
    <section id="expertise" class="py-10 md:py-14">
      <div class="container px-4">
        <div class="flex items-center mb-4 md:mb-6 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
            <Briefcase class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
            {content.expertise.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        
        <p class="text-center mb-6 md:mb-8 max-w-3xl mx-auto text-dark-gray text-sm md:text-base font-light">
          {content.expertise.description}
        </p> 
        
        <div class="flex flex-col md:flex-row gap-8 mb-0">
          <div class="md:w-1/2 bg-travailleur p-4 md:p-6 rounded-lg text-white flex flex-col justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-semibold mb-3 md:mb-4">{content.expertise.travailleurs.title}</h3>
              <p class="text-sm md:text-base font-light mb-4">{content.expertise.travailleurs.description}</p>
            </div>
            <Button 
              href={`/${lang}/services/travailleurs`}
              text={`${content.expertise.travailleurs.cta} →`} 
              variant="secondary"
              class="self-end bg-white text-travailleur hover:bg-gray-800 hover:text-white border-white"
            />
          </div>
          
          <div class="md:w-1/2 bg-employeur p-4 md:p-6 rounded-lg text-white flex flex-col justify-between">
            <div>
              <h3 class="text-lg md:text-xl font-semibold mb-3 md:mb-4">{content.expertise.employeurs.title}</h3>
              <p class="text-sm md:text-base font-light mb-4">{content.expertise.employeurs.description}</p>
            </div>
            <Button 
              href={`/${lang}/services/employeurs`}
              text={`${content.expertise.employeurs.cta} →`} 
              variant="secondary"
              class="self-end bg-white text-employeur hover:bg-gray-800 hover:text-white border-white"
            />
          </div>
        </div>

        <Picture 
          src={illustrationServices} 
          formats={['avif', 'webp', 'svg']}
          alt="Illustration des services" 
          class="w-full max-w-3xl md:max-w-4xl mx-auto mb-8"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 95vw, (max-width: 1200px) 80vw, 1200px"
        />
        
        <p class="text-center mb-4 md:mb-6 max-w-3xl mx-auto text-dark-gray text-sm md:text-base font-light leading-relaxed">
          {content.expertise.honoraires.intro} - 
          <a href={`/${lang}/honoraires`} class="text-travailleur hover:underline">{content.expertise.honoraires.linkText}</a>.
        </p>
        
        <ul class="list-none space-y-2 flex flex-col items-start max-w-md mx-auto">
          {content.expertise.honoraires.advantages.map((advantage: string) => (
            <li class="text-dark-gray font-light flex items-center w-full text-sm md:text-base">
              <CheckCircle class="text-travailleur mr-2 w-4 h-4 flex-shrink-0" />
              <span>{advantage}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
  
  <div class="full-bleed bg-white">
    <section id="profil" class="py-16 md:py-24 bg-svg-pattern">
      <div class="container mx-auto px-4">
        <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
            <User class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
            {content.profil.title}
          </h2>
          <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
        </div>
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-col md:flex-row items-start gap-6 md:gap-8">
            <div class="md:w-3/5 w-full">
              <Picture 
                src={profileImage} 
                formats={['avif', 'webp']} 
                alt="Christine Rizzo" 
                class="w-full h-auto object-cover rounded-lg" 
                decoding="async" 
                loading="lazy" 
                height="800"
                width="800" 
              />
            </div>
            <div class="md:w-2/5 w-full mt-4 md:mt-0 text-center md:text-left">
              <p class="text-dark-gray text-sm md:text-base font-light leading-relaxed mb-6">{content.profil.description}</p>
              <div class="flex justify-center md:justify-start">
                <Button 
                  href={`/${lang}/profil`} 
                  text={content.profil.cta}
                  variant="secondary"
                  class="uppercase text-sm font-light"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <CTA lang={currentLang} uiTranslations={uiTranslations} />

  {showArticlesSection && (
    <div id="articles" class="full-bleed bg-beige">
      <section class="py-16 md:py-24">
        <div class="container mx-auto px-4">
          <div class="flex items-center mb-6 md:mb-8 lg:mb-12 justify-center">
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
            <h2 class="text-xl sm:text-2xl font-light text-gray-600 mx-6 md:mx-10 uppercase text-center flex items-center">
              <FileText class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-travailleur" />
              {content.articlesTitle}
            </h2>
            <div class="flex-grow h-px bg-gray-300 max-w-xs"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recentArticles.map((article) => (
              <ArticleCard 
                article={article}
                lang={currentLang}
                url={`/${currentLang}/blog/${article.slug.split('/')[1] || ''}`}
                uiTranslations={uiTranslations}
              />
            ))}
          </div>
          <div class="text-center mt-12">
            <Button 
              href={`/${currentLang}/blog`} 
              text={`${content.viewAllArticles} →`}
              variant="secondary"
              class="uppercase text-sm font-light"
            />
          </div>
        </div>
      </section>
    </div>
  )}

</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollBtn = document.querySelector('.scroll-btn');
    if (scrollBtn) {
      scrollBtn.addEventListener('click', () => {
        const servicesSection = document.getElementById('services');
        if (servicesSection) {
          servicesSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  });
</script>