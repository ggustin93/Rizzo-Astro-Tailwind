---
import { getDataEntryById } from 'astro:content';
import '../../styles/editorial.css';
import { calEmbedTarget, isValidCalendarLink } from '../../utils/calendar.js';
import { ArrowRight, Calendar, Phone, Mail, Users } from 'astro-feather-icons2';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths } from '../../config/locales';
import { getTeam, profilePath } from '../../utils/team.js';
import { getUiTranslations } from '../../utils/ui-translations';

export const prerender = true;

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;
const profileEntry = await getDataEntryById('profile', 'profile');
const profileData = profileEntry?.data[lang] || profileEntry?.data['fr'];

// Slugs and images are resolved centrally so the listing links can never drift
// from the routes generated by [slug].astro.
const lawyersToDisplay = await getTeam(lang);

const ui = await getUiTranslations(lang);
const t = ui.team;
const appointmentLabel = ui.cta.actions.find(action => action.type === 'appointment')?.label;

// SEO data
const seoData = {
  title: profileData.seo?.title || `${t.title} - Christine Rizzo & Stephanie Michiels`,
  description: profileData.seo?.description || `Découvrez l'équipe d'avocates en droit du travail à Bruxelles.`,
  image: profileData.seo?.image || '/default-social-image.jpg',
  keywords: profileData.seo?.keywords?.join(', ') || ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <div class="editorial-page">
    <div class="max-w-6xl mx-auto px-4 pb-8 md:pb-12">
      <header class="team-header">
        <span class="team-header-icon"><Users aria-hidden="true" title="" /></span>
        <h1>{t.title}</h1>
      </header>
      
      <div class="space-y-12 md:space-y-16">
        {lawyersToDisplay.map((lawyer: any, index: number) => (
          <div class="team-entry">
            <!-- Lawyer Image -->
            <div class="team-photo">
              <a href={profilePath(lang, lawyer)} class="block rounded-lg">
              <img src={lawyer.image} alt={lawyer.imageAlt || lawyer.name} class="portrait" width="500" height="500" loading={index === 0 ? "eager" : "lazy"} decoding="async">
              </a>
            </div>
            
            <!-- Lawyer Information - Overview Only -->
            <div class="team-text">
              <header class="mb-5 md:mb-6">
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-employeur">{lawyer.name}</h2>
                {lawyer.role && <p class="team-role">{lawyer.role}</p>}
              </header>
              {lawyer.presentation.map((paragraph: string) => (
                <p class="text-sm md:text-base text-dark-gray mb-4 md:mb-6">{paragraph}</p>
              ))}
            </div>

            <!-- Contacts: under the photo on desktop, after the bio on mobile -->
            <div class="profile-actions">
                {isValidCalendarLink(lawyer.contact?.calendarLink) && (
                  <a class="profile-link" href={lawyer.contact.calendarLink} data-cal-link={calEmbedTarget(lawyer.contact.calendarLink)} data-cal-config='{"layout":"month_view"}' aria-label={`${ui.header.bookWith} ${lawyer.name}`}>
                    <span class="profile-link-icon"><Calendar aria-hidden="true" title="" /></span>{appointmentLabel}
                  </a>
                )}
                {lawyer.contact?.phone && (
                  <a class="profile-link" href={`tel:${lawyer.contact.phone.replace(/\s/g, '')}`}>
                    <span class="profile-link-icon"><Phone aria-hidden="true" title="" /></span>{lawyer.contact.phone}
                  </a>
                )}
                {lawyer.contact?.email && (
                  <a class="profile-link" href={`mailto:${lawyer.contact.email}`}>
                    <span class="profile-link-icon"><Mail aria-hidden="true" title="" /></span>{lawyer.contact.email}
                  </a>
                )}
                <a href={profilePath(lang, lawyer)} class="profile-link profile-link--more">
                  {t.viewProfile}
                  <ArrowRight aria-hidden="true" title="" class="w-4 h-4" />
                </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
