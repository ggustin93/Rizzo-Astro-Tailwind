---
import { getDataEntryById } from 'astro:content';
import '../../styles/editorial.css';
import { ArrowRight } from 'astro-feather-icons2';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths } from '../../config/locales';
import { getTeam, profilePath } from '../../utils/team.js';
import { getUiTranslations } from '../../utils/ui-translations';

export const prerender = true;

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;
const profileEntry = await getDataEntryById('profile', 'profile');
const profileData = profileEntry?.data[lang] || profileEntry?.data['fr'];

// Slugs and images are resolved centrally so the listing links can never drift
// from the routes generated by [slug].astro.
const lawyersToDisplay = await getTeam(lang);

const t = (await getUiTranslations(lang)).team;

// SEO data
const seoData = {
  title: profileData.seo?.title || `${t.title} - Christine Rizzo & Stephanie Michiels`,
  description: profileData.seo?.description || `Découvrez l'équipe d'avocates en droit du travail à Bruxelles.`,
  image: profileData.seo?.image || '/default-social-image.jpg',
  keywords: profileData.seo?.keywords?.join(', ') || ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <div class="editorial-page">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-gray-800 mb-8 md:mb-12 text-center">{t.title}</h1>
      
      <div class="space-y-12 md:space-y-16">
        {lawyersToDisplay.map((lawyer: any, index: number) => (
          <div class="team-entry flex flex-col md:flex-row gap-8 md:gap-12 items-start">
            <!-- Lawyer Image -->
            <div class="w-full md:w-1/3">
              <a href={profilePath(lang, lawyer)} class="block rounded-lg">
              <img src={lawyer.image} alt={lawyer.imageAlt || lawyer.name} class="portrait" width="500" height="500" loading={index === 0 ? "eager" : "lazy"} decoding="async">
              </a>
            </div>
            
            <!-- Lawyer Information - Overview Only -->
            <div class="w-full md:w-2/3">
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-employeur mb-4 md:mb-6">{lawyer.name}</h2>
              
              {lawyer.role && <p class="text-employeur mb-4">{lawyer.role}</p>}
              {lawyer.presentation.map((paragraph: string) => (
                <p class="text-sm md:text-base text-dark-gray mb-4 md:mb-6">{paragraph}</p>
              ))}
              
              <div class="mt-6">
                <a 
                  href={profilePath(lang, lawyer)}
                  class="profile-link"
                >
                  {t.viewProfile}
                  <ArrowRight aria-hidden="true" title="" class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
