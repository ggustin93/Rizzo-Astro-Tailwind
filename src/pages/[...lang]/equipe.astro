---
import { getDataEntryById } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CheckCircle, Globe, Briefcase, Mic, Coffee, BookOpen } from 'astro-feather-icons';

export const prerender = true;

export async function getStaticPaths() {
  return ['fr', 'en', 'it'].map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const profileEntry = await getDataEntryById('profile', 'profile');
if (!profileEntry) {
  throw new Error("Profile entry not found. Make sure you have a `profile.yml` file in `src/content/profile`.");
}
const profileData = profileEntry.data[lang] || profileEntry.data['fr']; // Use French as fallback

if (!profileData) {
  throw new Error(`Content not found for language: ${lang}`);
}

// Extract the lawyers array from the new structure
const lawyers = profileData.lawyers || [];

if (!lawyers || lawyers.length === 0) {
  throw new Error(`No lawyers found in profile data for language: ${lang}`);
}

// Translations
const translations = {
  fr: {
    teamTitle: "L'équipe",
    languages: "Langues",
    career: "Parcours",
    conferences: "Conférences",
    publications: "Publications",
    with: "avec",
    inCollaborationWith: "En collaboration avec"
  },
  en: {
    teamTitle: "The Team",
    languages: "Languages",
    career: "Career",
    conferences: "Conferences",
    publications: "Publications",
    with: "with",
    inCollaborationWith: "In collaboration with"
  },
  it: {
    teamTitle: "Il Team",
    languages: "Lingue",
    career: "Percorso",
    conferences: "Conferenze",
    publications: "Pubblicazioni",
    with: "con",
    inCollaborationWith: "In collaborazione con"
  }
};

const t = translations[lang as keyof typeof translations];

// SEO data
const seoData = {
  title: profileData.seo?.title || `${t.teamTitle} - Christine Rizzo & Stéphanie Michiels`,
  description: profileData.seo?.description || `Découvrez l'équipe d'avocates spécialisées en droit du travail à Bruxelles.`,
  image: profileData.seo?.image || 'https://v5--crizzo.netlify.app/_astro/logo_crizzo_calli3.8EyI_Q3S_2joHla.svg',
  keywords: profileData.seo?.keywords?.join(', ') || ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <div class="bg-white md:my-20 p-4 md:p-8">
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-light text-accent mb-8 md:mb-12 text-center">{t.teamTitle}</h1>
      
      <div class="space-y-12 md:space-y-16">
        {lawyers.map((lawyer: any, index: number) => (
          <div class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 md:gap-12 items-start`}>
            <!-- Lawyer Image -->
            <div class="w-full md:w-1/3">
              <img src={lawyer.image} alt={lawyer.name} class="w-full rounded-lg shadow-lg">
            </div>
            
            <!-- Lawyer Information - Overview Only -->
            <div class="w-full md:w-2/3">
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-accent mb-2 md:mb-4">{lawyer.name}</h2>
              <h3 class="text-xl md:text-2xl font-light text-black mb-4 md:mb-6">{lawyer.title}</h3>
              
              {lawyer.bio && lawyer.bio.slice(0, 2).map((paragraph: string) => (
                <p class="text-sm md:text-base text-dark-gray mb-4 md:mb-6">{paragraph}</p>
              ))}
              
              <div class="mt-6">
                <a 
                  href={`/${lang}/equipe/${lawyer.name.toLowerCase().replace(' ', '-').replace('é', 'e')}/`}
                  class="inline-flex items-center px-6 py-3 bg-accent text-white rounded-lg hover:bg-travailleur transition-colors duration-300"
                >
                  {lang === 'fr' ? 'Découvrir le profil complet' : lang === 'en' ? 'View full profile' : 'Scopri il profilo completo'}
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
