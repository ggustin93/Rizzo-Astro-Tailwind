---
import { getEntry, getDataEntryById } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactForm from '../../components/ContactForm.astro';
import CTA from '../../components/CTA.astro';
import { localePaths } from '../../config/locales';

export const prerender = true;

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;
const contactEntry = await getDataEntryById('contact', 'contact');
if (!contactEntry) {
  throw new Error("Contact entry not found! Make sure you have a `contact.yml` file in `src/content/contact`.");
}
const contactData = contactEntry.data[lang];









const seoData = {
  title: contactData.seo?.title || `Contact - Christine Rizzo`,
  description: contactData.seo?.description || "Prenez contact avec Christine Rizzo, avocate en droit du travail à Bruxelles.",
  image: contactData.seo?.image || '/default-social-image.jpg',
  keywords: contactData.seo?.keywords?.join(', ') || ''
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  keywords={seoData.keywords}
  lang={lang}
>
  <main class="container mx-auto px-4 py-8 md:py-16">
    <h1 class="text-3xl md:text-4xl font-light mb-8 md:mb-12 text-black text-center">{contactData.heading}</h1>
    
    <!-- CTA Component -->
    <CTA />
    
    <!-- Contact Form Section -->
    <div class="container mx-auto px-2 sm:px-4 py-12 md:py-16">
      <ContactForm />
    </div>
  </main>
</BaseLayout>

