---
// src/pages/credits.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCALES, localePaths } from '../config/locales';
const supportedLanguages = LOCALES;
type SupportedLanguage = typeof supportedLanguages[number];

export interface Props {
  currentLang: SupportedLanguage;
}

export async function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.params;

---

<BaseLayout 
  title="Crédits" 
  description="Crédits du site web de Christine Rizzo" 
  lang={lang as SupportedLanguage}
  allowIndexing={false}
>
  <h1 class="text-4xl font-bold mb-4">Credits</h1>
  <p class="mb-4">Polices fournies par <a href="http://www.onlinewebfonts.com">Web Fonts</a> sous licence CC BY 4.0</p>
</BaseLayout>