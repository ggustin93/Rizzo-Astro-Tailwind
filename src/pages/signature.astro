---
import { getEntry } from 'astro:content';

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const contactInfo = siteConfigEntry?.data?.contactInfo || {
  phone: '+32 488 40 45 49',
  whatsapp: '32488404549',
  email: 'c.rizzo@avocat.be',
  linkedin: 'https://www.linkedin.com/in/christine-rizzo/'
};

// Formater le numéro de téléphone pour l'affichage (avec points)
const formattedPhone = contactInfo.phone.replace('+32 ', '').replace(/(\d{3})(\d{2})(\d{2})(\d{2})/, '$1.$2.$3.$4');
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Signature Email</title>
</head>
<body>
  <table cellpadding="0" cellspacing="0" border="0" style="font-family: Arial, sans-serif; font-size: 14px; line-height: 1.5; color: #333333; border-collapse: collapse;">
    <tr>
      <td style="padding: 0 20px 0 0; vertical-align: middle;">
        <img src="https://cdn.prod.website-files.com/66a3633bf638ce4da95b8ad7/66d4b4609915d515de0773ac_logo_crizzo.png" alt="Logo Christine Rizzo" width="300" height="auto" style="display: block; border: 0;" />
      </td>
      <td style="padding: 0; vertical-align: top; border-left: 1px solid #dddddd; padding-left: 20px;">
        <table cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="padding: 0 0 5px 0;">
              <span style="font-size: 18px; font-weight: bold; color: #068D9D;">Christine Rizzo</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 0 10px 0;">
              <span style="color: #666666; font-size: 14px;">Avocate</span>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 0 5px 0; border-top: 1px solid #eeeeee;">
              <span style="color: #333333; font-weight: bold;">Email:&nbsp;&nbsp;</span>
              <a href={`mailto:${contactInfo.email}`} style="color: #333333; text-decoration: none;">{contactInfo.email}</a>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 0 5px 0; border-top: 1px solid #eeeeee;">
              <span style="color: #333333; font-weight: bold;">Téléphone:&nbsp;&nbsp;</span>
              <a href={`tel:+${contactInfo.whatsapp}`} style="color: #333333; text-decoration: none;">{formattedPhone}</a>
            </td>
          </tr>
          <tr>
            <td style="padding: 0 0 5px 0; border-top: 1px solid #eeeeee;">
              <span style="color: #333333; font-weight: bold;">Site web:&nbsp;&nbsp;</span>
              <a href="https://crizzo-avocate.be" style="color: #333333; text-decoration: none;">crizzo-avocate.be</a>
            </td>
          </tr>
          <tr>
            <td style="padding: 10px 0 0 0; border-top: 1px solid #eeeeee;">
              <a href={contactInfo.linkedin} style="text-decoration: none; margin-right: 10px;">
                <img src="https://cdn.prod.website-files.com/66a3633bf638ce4da95b8ad7/66d4b460d66aad3c82aea265_Logo_LinkedIn.png" alt="LinkedIn" width="20" height="20" style="vertical-align: middle; border: 0;">
              </a>
              <a href={`https://wa.me/${contactInfo.whatsapp}`} style="text-decoration: none;">
                <img src="https://cdn.prod.website-files.com/66a3633bf638ce4da95b8ad7/66d4b460e9cbcd03c68d5d77_Logo_WhatsApp.png" alt="WhatsApp Business" width="20" height="20" style="vertical-align: middle; border: 0;">
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>