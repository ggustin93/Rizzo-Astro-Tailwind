---
// src/pages/index.astro
const acceptLanguage = Astro.request.headers.get('accept-language') || '';
const userAgent = Astro.request.headers.get('user-agent') || '';

// Détection des bots (liste plus complète)
const isBot = /bot|crawler|spider|crawling/i.test(userAgent);

if (isBot) {
  // Tous les bots vont vers français (ou votre langue principale)
  return Astro.redirect('/fr/', 302);
}

// Humains : détection de langue
if (acceptLanguage.includes('en')) {
  return Astro.redirect('/en/', 302);
} else if (acceptLanguage.includes('it')) {
  return Astro.redirect('/it/', 302);
} else {
  return Astro.redirect('/fr/', 302);
}
