---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home } from 'astro-feather-icons2';
import illustration404 from '../assets/images/404_illustration.svg';
import { LOCALE_PATTERN, DEFAULT_LOCALE, localeFromPath } from '../config/locales';
import { getUiTranslations } from '../utils/ui-translations';

// Récupère la langue depuis l'URL
const lang = localeFromPath(Astro.url.pathname);

const t = (await getUiTranslations(lang)).notFound;
---

<BaseLayout 
  title={t.title} 
  description={t.message} 
  lang={lang}
  allowIndexing={false}
>
  <main class="flex flex-col items-center justify-center min-h-[60vh] py-10 md:py-20">
    <div class="container px-4 mx-auto">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="text-center md:text-left">
            <h1 class="text-8xl font-extralight text-accent mb-4">404</h1>
            <h2 class="text-2xl md:text-3xl font-light text-gray-800 mb-4">{t.title}</h2>
            <p class="text-gray-600 mb-8">
              {t.message}
            </p>
            <a 
              href={`/${lang}`}
              class="inline-flex items-center bg-transparent text-travailleur border border-travailleur px-4 md:px-6 py-2 md:py-3 rounded-sm hover:bg-travailleur hover:text-white transition duration-300 uppercase text-sm md:text-base font-light group"
            >
              <Home class="w-5 h-5 mr-2" /> {t.backHome}
            </a>
          </div>
          <div class="flex justify-center md:justify-end">
            <img 
              src={illustration404.src} 
              alt="Illustration 404" 
              class="w-full max-w-md" 
              loading="eager"
              width="500"
              height="400"
            />
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ localePattern: LOCALE_PATTERN, defaultHome: `/${DEFAULT_LOCALE}/` }}>
  // Si on arrive sur la page 404 à la racine exacte, rediriger vers la langue par défaut.
  // Le motif de langues vient de src/config/locales.ts, pas d'une liste recopiée ici.
  if (window.location.pathname === "/" || window.location.pathname === "") {
    // Double vérification pour s'assurer qu'on est vraiment à la racine
    if (!window.location.pathname.match(new RegExp(`^/(${localePattern})(?:/|$)`))) {
      window.location.href = defaultHome;
    }
  }
</script>
