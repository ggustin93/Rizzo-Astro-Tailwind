---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home } from 'astro-feather-icons2';
import illustration404 from '../assets/images/404_illustration.svg';

// Définit les langues supportées et la langue par défaut
const supportedLanguages = ['fr', 'en', 'it'] as const;
type SupportedLanguage = typeof supportedLanguages[number];
const defaultLang = 'fr' as SupportedLanguage;

// Récupère la langue depuis l'URL
const lang = supportedLanguages.find(l => Astro.url.pathname.startsWith(`/${l}/`)) || defaultLang;

const translations = {
  fr: {
    title: 'Page non trouvée - 404',
    message: 'La page que vous recherchez n\'existe pas ou a été déplacée.',
    backHome: 'Retour à l\'accueil',
    description: 'Erreur 404 - Page non trouvée sur le site de Me Christine Rizzo, avocate en droit du travail à Bruxelles.'
  },
  en: {
    title: 'Page not found - 404',
    message: 'The page you are looking for doesn\'t exist or has been moved.',
    backHome: 'Back to home',
    description: 'Error 404 - Page not found on Christine Rizzo\'s website, attorney specialized in labor law in Brussels.'
  },
  it: {
    title: 'Pagina non trovata - 404',
    message: 'La pagina che stai cercando non esiste o è stata spostata.',
    backHome: 'Torna alla home',
    description: 'Errore 404 - Pagina non trovata sul sito di Christine Rizzo, avvocato specializzato in diritto del lavoro a Bruxelles.'
  }
};

// On est certain que 'lang' est une clé valide ici
const t = translations[lang];
---

<BaseLayout 
  title={t.title} 
  description={t.message} 
  lang={lang}
  allowIndexing={false}
>
  <main class="flex flex-col items-center justify-center min-h-[60vh] py-10 md:py-20">
    <div class="container px-4 mx-auto">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="text-center md:text-left">
            <h1 class="text-8xl font-extralight text-accent mb-4">404</h1>
            <h2 class="text-2xl md:text-3xl font-light text-gray-800 mb-4">{t.title}</h2>
            <p class="text-gray-600 mb-8">
              {t.message}
            </p>
            <a 
              href={`/${lang}`}
              class="inline-flex items-center bg-transparent text-travailleur border border-travailleur px-4 md:px-6 py-2 md:py-3 rounded-sm hover:bg-travailleur hover:text-white transition duration-300 uppercase text-sm md:text-base font-light group"
            >
              <Home class="w-5 h-5 mr-2" /> {t.backHome}
            </a>
          </div>
          <div class="flex justify-center md:justify-end">
            <img 
              src={illustration404.src} 
              alt="Illustration 404" 
              class="w-full max-w-md" 
              loading="eager"
              width="500"
              height="400"
            />
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Si on arrive sur la page 404 à la racine exacte, rediriger vers /fr/
  // Vérifier explicitement qu'on est bien à la racine du site pour ne pas interférer avec le changeur de langue
  if (window.location.pathname === "/" || window.location.pathname === "") {
    // Double vérification pour s'assurer qu'on est vraiment à la racine
    if (!window.location.pathname.match(/^\/(fr|en|it)(?:\/|$)/)) {
      window.location.href = "/fr/";
    }
  }
</script>
