---
// Import des props
import { Globe } from 'astro-feather-icons2';
const { currentLang } = Astro.props;
const langs = ['fr', 'en', 'it'];
---

<style>
  /* Masquer le menu déroulant sur mobile */
  @media (max-width: 768px) {
    #language-select {
      display: none;
    }
    .mobile-lang-links {
      display: block;
    }
  }

  /* Masquer les liens sur les écrans plus grands */
  @media (min-width: 769px) {
    .mobile-lang-links {
      display: none;
    }
  }

  /* Souligner la langue actuelle sur mobile */
  .mobile-lang-links a.current-lang {
    text-decoration: underline;
    text-decoration-color: black;
  }
  
  /* Animation de soulignement au hover */
  .lang-select-wrapper {
    position: relative;
  }
  
  .lang-select-wrapper::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: 0;
    left: 0;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  
  .lang-select-wrapper:hover::after {
    width: 100%;
  }
</style>

<div class="relative inline-flex items-center group">
  <Globe class="w-4 h-4 mr-1.5 text-black transition-colors duration-300 group-hover:text-gray-700" />
  <div class="lang-select-wrapper">
    <select 
      id="language-select"
      class="appearance-none text-black text-sm font-light bg-transparent border-0 pr-6 uppercase transition-colors duration-300 focus:outline-none group-hover:text-gray-700"
    >
      {langs.map((lang) => (
        <option value={lang} selected={lang === currentLang}>
          {lang.toUpperCase()}
        </option>
      ))}
    </select>
  </div>
  <div class="pointer-events-none absolute right-0 flex items-center text-black group-hover:text-gray-700">
    <svg class="fill-current h-4 w-4 transition-colors duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
      <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path>
    </svg>
  </div>
</div>

<div class="mobile-lang-links flex items-center space-x-3">
  <Globe class="w-4 h-4 text-black flex-shrink-0" />
  {langs.map((lang) => (
    <a 
      href="#"
      data-lang={lang}
      class={`text-sm font-light uppercase ${lang === currentLang ? 'text-black current-lang' : 'text-gray-500'} hover:text-black transition-colors duration-300`}
    >
      {lang.toUpperCase()}
    </a>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('language-select');
    const langLinks = document.querySelectorAll('.mobile-lang-links a');

    const handleLanguageChange = (newLang) => {
      const currentPath = window.location.pathname;
      const supportedLanguages = ['fr', 'en', 'it']; // Assurez-vous que c'est défini

      // 1. Vérifie si on est déjà sur la bonne langue
      if (currentPath.startsWith(`/${newLang}/`) || currentPath === `/${newLang}`) {
        console.log(`Already on language: ${newLang}. No redirect needed.`);
        return; // Ne fait rien si la langue est déjà correcte
      }

      // 2. Gère la racine et reconstruit le chemin correctement
      let newPath;
      if (currentPath === '/' || currentPath === '') {
        // Cas spécifique de la racine
        newPath = `/${newLang}/`; 
      } else {
        // Décompose le chemin pour mieux le reconstruire
        const pathParts = currentPath.split('/').filter(Boolean); // Sépare les parties et enlève les vides
        if (pathParts.length === 0) {
           // Si après filtrage on est vide (ex: /fr), on va vers la nouvelle langue
           newPath = `/${newLang}/`;
        } else if (supportedLanguages.includes(pathParts[0])) {
          // Si la première partie EST une langue, on la remplace
          newPath = `/${newLang}/${pathParts.slice(1).join('/')}`;
        } else {
          // Si la première partie N'EST PAS une langue, on insère la nouvelle langue au début
          newPath = `/${newLang}/${pathParts.join('/')}`;
        }
        // S'assure qu'il y a un slash à la fin si ce n'est pas un fichier
        if (!newPath.endsWith('/') && !newPath.includes('.')) {
           newPath += '/';
        }
      }

      console.log(`Redirecting to: ${newPath}`);
      window.location.href = newPath;
    };

    if (select) {
      console.log('Language select element found');  // Debugging
      select.addEventListener('change', (event) => {
        const target = event.target as HTMLSelectElement;
        handleLanguageChange(target.value);
      });
    } else {
      console.log('Language select element not found');  // Debugging
    }

    langLinks.forEach(link => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const target = event.target as HTMLAnchorElement;
        handleLanguageChange(target.dataset.lang);
      });
    });
  });
</script>