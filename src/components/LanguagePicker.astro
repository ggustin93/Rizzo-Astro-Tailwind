---
// Import des props
import Icon from './Icon.astro';
const { currentLang } = Astro.props;
const langs = ['fr', 'en', 'it'];
---

<style>
  /* Masquer le menu déroulant sur mobile */
  @media (max-width: 768px) {
    #language-select {
      display: none;
    }
    .mobile-lang-links {
      display: block;
    }
  }

  /* Masquer les liens sur les écrans plus grands */
  @media (min-width: 769px) {
    .mobile-lang-links {
      display: none;
    }
  }

  /* Souligner la langue actuelle sur mobile */
  .mobile-lang-links a.current-lang {
    text-decoration: underline;
    text-decoration-color: black;
  }
  
  /* Animation de soulignement au hover */
  .lang-select-wrapper {
    position: relative;
  }
  
  .lang-select-wrapper::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: 0;
    left: 0;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  
  .lang-select-wrapper:hover::after {
    width: 100%;
  }
</style>

<div class="relative inline-flex items-center group">
  <Icon name="globe" class="w-4 h-4 mr-1.5 text-black transition-colors duration-300 group-hover:text-gray-700" />
  <div class="lang-select-wrapper">
    <select 
      id="language-select"
      class="appearance-none text-black text-sm font-light bg-transparent border-0 pr-6 uppercase transition-colors duration-300 focus:outline-none group-hover:text-gray-700"
    >
      {langs.map((lang) => (
        <option value={lang} selected={lang === currentLang}>
          {lang.toUpperCase()}
        </option>
      ))}
    </select>
  </div>
  <div class="pointer-events-none absolute right-0 flex items-center text-black group-hover:text-gray-700">
    <svg class="fill-current h-4 w-4 transition-colors duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
      <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path>
    </svg>
  </div>
</div>

<div class="mobile-lang-links flex items-center space-x-3">
  <Icon name="globe" class="w-4 h-4 text-black flex-shrink-0" />
  {langs.map((lang) => (
    <a 
      href="#"
      data-lang={lang}
      class={`text-sm font-light uppercase ${lang === currentLang ? 'text-black current-lang' : 'text-gray-500'} hover:text-black transition-colors duration-300`}
    >
      {lang.toUpperCase()}
    </a>
  ))}
</div>

<script>
  import { initLanguagePicker } from '../scripts/language-picker.ts';
  document.addEventListener('astro:page-load', initLanguagePicker);
</script>