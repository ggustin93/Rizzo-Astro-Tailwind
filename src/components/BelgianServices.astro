---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import { ArrowRight, Briefcase, User, ChevronDown } from 'astro-feather-icons2';
const { content, lang, audience } = Astro.props;
const isWorkerPage = audience === 'travailleurs';
const AudienceIcon = isWorkerPage ? User : Briefcase;
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
  imageAlt={content.seo.imageAlt || content.seo.title}
  keywords={content.seo.keywords?.join(', ')}
  lang={lang}
>
  <article class:list={['services-page', { 'services-page--worker': isWorkerPage }]}>
    <header class="services-header">
      <span class="audience-icon"><AudienceIcon aria-hidden="true" title="" class="w-7 h-7" /></span>
      <h1>{content.title}</h1>
      {content.description && <p class="whitespace-pre-line">{content.description}</p>}
    </header>
    <div class="services-layout">
      <nav class="services-index" aria-label={content.servicesTitle}>
        <p class="index-title">{content.servicesTitle}</p>
        {content.sections.map((section, index) => (
          <a href={`#service-${index}`}><span>{section.title}</span><ArrowRight aria-hidden="true" title="" class="w-4 h-4 shrink-0" /></a>
        ))}
      </nav>
      <div class="services-content">
      <div class="space-y-10">

        {content.sections.map((section, index) => (
          <section aria-labelledby={`service-${index}`}>
            <h2
              id={`service-${index}`}
              class="service-title"
            >{section.title}</h2>
            {section.description && <p class="whitespace-pre-line leading-relaxed text-dark-gray">{section.description}</p>}
            {section.situations?.length > 0 && (
              <ul class:list={['situations text-dark-gray leading-relaxed', section.description && 'mt-5']}>
                {section.situations.map(situation => (
                  <li>
                    {content.situationsDisplay === 'accordion' ? (
                      <details class="situation-disclosure">
                        <summary><span>{situation.question}</span><ChevronDown aria-hidden="true" title="" class="w-5 h-5 shrink-0" /></summary>
                        <p class="whitespace-pre-line">{situation.answer}</p>
                      </details>
                    ) : (
                      <><strong class="situation-question whitespace-pre-line">{situation.question}</strong>{' '}
                      <span class="whitespace-pre-line">{situation.answer}</span></>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
      <div class="mt-10">
        <Button
          href={`/${lang}/${content.ctaDestination}/`}
          text={content.ctaText}
          icon={ArrowRight}
          class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
        />
      </div>
    </div>
    </div>
  </article>
</BaseLayout>

<style>
  .services-page { --service-color: var(--employer-brand); --service-ink: var(--employer-brand); margin: 2rem 0 5rem; }
  .services-page--worker { --service-color: var(--worker-brand); --service-ink: var(--worker-ink); }
  .services-header { text-align: center; background: var(--service-ink); color: white; border-radius: 1rem; padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem); margin-bottom: 3rem; }
  .audience-icon { display: inline-flex; padding: .9rem; border: 1px solid #ffffff66; border-radius: 50%; color: white; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(1.75rem, 3.6vw, 3.15rem); line-height: 1.2; letter-spacing: -.025em; color: white; text-wrap: balance; max-width: 28ch; margin-inline: auto; }
  .services-header p { max-width: 65ch; margin: 1.5rem auto 0; color: white; }
  .services-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  .services-index { border-top: 3px solid var(--service-color); padding-top: 1rem; }
  .index-title { color: #263952; font-weight: 600; margin-bottom: .8rem; }
  .services-index a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid #dedbd8; font-size: .9rem; line-height: 1.5; color: #414852; }
  .services-index a:hover { color: var(--service-color); text-decoration: underline; text-underline-offset: .2em; }
  .services-index a:focus-visible { outline: 2px solid var(--service-color); outline-offset: 4px; }
  .services-content { background: white; border-radius: 1rem; padding: clamp(1.5rem, 4vw, 3.5rem); min-width: 0; }
  .service-title { scroll-margin-top: 8rem; }
  section + section { border-top: 1px solid #e4e7ea; padding-top: 2.5rem; }
  .service-title { font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.35; color: var(--service-ink); font-weight: 600; margin-bottom: 1.25rem; text-wrap: pretty; }
  .situations { list-style: none; display: grid; gap: 1.75rem; }
  .situations li:not(:last-child) { border-bottom: 1px solid #e4e7ea; padding-bottom: 1rem; }
  .situation-disclosure summary { display: flex; align-items: start; justify-content: space-between; gap: 1rem; min-height: 44px; cursor: pointer; color: #263952; font-weight: 600; list-style: none; }
  .situation-disclosure summary::-webkit-details-marker { display: none; }
  .situation-disclosure summary:focus-visible { outline: 2px solid var(--service-color); outline-offset: 5px; }
  .situation-disclosure summary :global(svg) { color: var(--service-color); margin-top: .2rem; }
  .situation-disclosure[open] summary :global(svg) { transform: rotate(180deg); }
  .situation-disclosure[open] summary { color: var(--service-ink); }
  .situation-disclosure p { padding: .75rem 0 .25rem; max-width: 65ch; }
  .situation-question { display: block; font-weight: 600; color: #263952; margin-bottom: .4rem; }
  @media (min-width: 1024px) {
    .services-layout { grid-template-columns: minmax(14rem, 1fr) minmax(0, 2.5fr); gap: 3rem; }
    .services-index { position: sticky; top: 7rem; }
  }
</style>
