---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import { ArrowRight } from 'astro-feather-icons2';
const { content, lang, audience } = Astro.props;
const isWorkerPage = audience === 'travailleurs';
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
  imageAlt={content.seo.imageAlt || content.seo.title}
  keywords={content.seo.keywords?.join(', ')}
  lang={lang}
>
  <div class="bg-white my-6 md:my-20 px-6 py-10 md:p-16 rounded-lg">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-light text-black mb-8">{content.title}</h1>
      {content.description && <p class="whitespace-pre-line text-dark-gray leading-relaxed mb-8">{content.description}</p>}
      <p class="text-xl text-dark-gray mb-8">{content.servicesTitle}</p>
      <div class="space-y-10">
        {content.sections.map((section, index) => (
          <section aria-labelledby={`service-${index}`}>
            <h2
              id={`service-${index}`}
              class:list={['text-xl md:text-2xl font-semibold mb-4', isWorkerPage ? 'text-travailleur' : 'text-employeur']}
            >{section.title}</h2>
            {section.description && <p class="whitespace-pre-line leading-relaxed text-dark-gray">{section.description}</p>}
            {section.situations?.length > 0 && (
              <ul class:list={['space-y-5 text-dark-gray leading-relaxed', isWorkerPage ? 'list-disc pl-6' : 'list-none', section.description && 'mt-5']}>
                {section.situations.map(situation => (
                  <li>
                    <em class="whitespace-pre-line">{situation.question}</em>{' '}
                    <span class="whitespace-pre-line">{situation.answer}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
      <div class="mt-10">
        <Button
          href={`/${lang}/${content.ctaDestination}/`}
          text={content.ctaText}
          icon={ArrowRight}
          class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
        />
      </div>
    </div>
  </div>
</BaseLayout>
