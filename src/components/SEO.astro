---
import { SEO as AstroSEO } from 'astro-seo';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: 'fr' | 'en' | 'it';
  pathname: string;
  image?: string;
  keywords?: string | string[];
  type?: 'article' | 'website';
}

const {
  title,
  description,
  canonical,
  lang,
  pathname,
  image,
  keywords,
  type = 'website',
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://crizzo-avocate.be';
const siteName = 'Christine Rizzo - Avocate';
const defaultImage = '/default-social-image.png'; // Image par défaut à la racine de /public
const defaultFavicon = '/favicon.ico';

// Gestion de l'image pour les réseaux sociaux
let fullImageUrl;
if (image && (image.startsWith('http://') || image.startsWith('https://'))) {
  fullImageUrl = image;
} else {
  // Gère les images locales (attendues dans /public/assets/images/) ou l'image par défaut
  const imagePath = image ? `/assets/images/${image}` : defaultImage;
  fullImageUrl = new URL(imagePath, siteUrl).toString();
}

const keywordsString = Array.isArray(keywords) ? keywords.join(', ') : keywords;

// Langues supportées par le site
const supportedLanguages = ['fr', 'en', 'it'];
---

<AstroSEO
  title={title}
  description={description}
  canonical={canonical}
  noindex={false}
  nofollow={false}
  openGraph={{
    basic: {
      title: title,
      type: type,
      image: fullImageUrl,
      url: canonical,
    },
    optional: {
      description: description,
      locale: lang,
      siteName: siteName,
    },
    image: {
      url: fullImageUrl,
      alt: `Image pour ${title}`,
      type: "image/png",
      width: 1200,
      height: 630,
    },
    article: type === 'article' ? {
      publishedTime: new Date().toISOString(),
      authors: ["Christine Rizzo"],
    } : undefined,
  }}
  twitter={{
    card: "summary_large_image",
    site: "@ChristineRizzo",
    creator: "@ChristineRizzo",
    title: title,
    description: description,
    image: fullImageUrl,
    imageAlt: `Image pour ${title}`,
  }}
  extend={{
    link: [
      { rel: "icon", href: defaultFavicon },
      // Générer les balises hreflang pour toutes les langues supportées
      ...supportedLanguages.map(l => ({
        rel: "alternate",
        hreflang: l,
        href: `${siteUrl}/${l}${pathname.substring(3)}`
      })),
      // Ajout de la balise hreflang x-default
      { rel: "alternate", hreflang: "x-default", href: `${siteUrl}/fr${pathname.substring(3)}` }
    ],
    meta: [
      { name: "author", content: siteName },
      { name: "language", content: lang },
      ...(keywordsString ? [{ name: "keywords", content: keywordsString }] : []),
      // Les balises 'robots' et 'googlebot' sont gérées par noindex/nofollow.
      // Les autres balises (twitter, og) sont gérées par les sections dédiées.
    ],
  }}
/>