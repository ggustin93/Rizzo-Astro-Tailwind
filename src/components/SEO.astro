---
import { SEO as AstroSEO } from 'astro-seo';
import { getEntry } from 'astro:content';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  keywords?: string | string[];
  type?: 'article' | 'website';
  lang?: string;
}

// Définition du type pour la configuration du site
interface SiteConfig {
  seo?: {
    allowIndexing?: boolean;
    siteUrl?: string;
    siteName?: string;
    defaultSocialImage?: string;
    favicon?: string;
    siteDescription?: string;
  };
  // autres propriétés potentielles
  sectionsVisibility?: boolean;
  calendarLink?: string;
}

const {
  title,
  description,
  canonical,
  image,
  keywords,
  type = 'website',
  lang = 'fr',
} = Astro.props;

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const siteConfig = (siteConfigEntry?.data || {}) as SiteConfig;
const seoConfig = siteConfig.seo || {};

// Utiliser les valeurs de configuration ou les valeurs par défaut
const siteUrl = seoConfig.siteUrl || import.meta.env.SITE || 'https://crizzo-avocate.be/';
const siteName = seoConfig.siteName || 'Christine Rizzo - Avocate';
const defaultImage = seoConfig.defaultSocialImage || '/assets/images/default-social-image.png'; 

// Fix image URL creation to handle both absolute and relative paths
let fullImageUrl;
if (image) {
  // Check if the image is already an absolute URL
  if (image.startsWith('http://') || image.startsWith('https://')) {
    fullImageUrl = image;
  } else {
    // Handle relative paths correctly
    const imagePath = image.startsWith('/') ? image : `/${image}`;
    fullImageUrl = new URL(imagePath, siteUrl).toString();
  }
} else {
  // Ensure default image path is correctly formatted
  const defaultImagePath = defaultImage.startsWith('/') ? defaultImage : `/${defaultImage}`;
  fullImageUrl = new URL(defaultImagePath, siteUrl).toString();
}

const keywordsString = Array.isArray(keywords) ? keywords.join(', ') : keywords;

const languages = ['fr', 'en', 'it'];
---

<AstroSEO
  title={title}
  description={description}
  canonical={canonical || siteUrl}
  openGraph={{
    basic: {
      title: title,
      type: type,
      image: fullImageUrl,
      url: canonical || siteUrl,
    },
    optional: {
      description: description,
      locale: lang,
      siteName: siteName,
    },
    image: {
      url: fullImageUrl,
      secureUrl: fullImageUrl,
      alt: siteName,
      type: fullImageUrl.toLowerCase().endsWith('.jpg') || fullImageUrl.toLowerCase().endsWith('.jpeg') ? "image/jpeg" : "image/png",
      width: 1200,
      height: 630,
    },
    article: type === 'article' ? {
      publishedTime: new Date().toISOString(),
      authors: ["Christine Rizzo"],
    } : undefined,
  }}
  twitter={{
    card: "summary_large_image",
    site: "@ChristineRizzo",
    creator: "@ChristineRizzo",
    title: title,
    description: description,
    image: fullImageUrl,
    imageAlt: siteName,
  }}
  extend={{
    link: [
      { rel: "icon", href: seoConfig.favicon || "/favicon.ico" },
      ...languages.map(l => ({ rel: "alternate", hreflang: l, href: `${siteUrl}/${l}` })),
    ],
    meta: [
      { name: "author", content: "Christine Rizzo" },
      { name: "robots", content: seoConfig.allowIndexing ? "index, follow" : "noindex, nofollow" },
      { name: "language", content: lang },
      ...(keywordsString ? [{ name: "keywords", content: keywordsString }] : []),
      { property: "og:image:width", content: "1200" },
      { property: "og:image:height", content: "630" },
      { name: "twitter:card", content: "summary_large_image" },
      { name: "twitter:title", content: title },
      { name: "twitter:description", content: description },
      { name: "twitter:image", content: fullImageUrl },
    ],
  }}
/>