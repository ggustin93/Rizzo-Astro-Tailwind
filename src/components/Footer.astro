---
import { Image } from 'astro:assets';
import { Phone, Mail, MapPin, ChevronDown } from 'astro-feather-icons2';
import IconLinkedin from './IconLinkedIn.astro';
import logoImage from '../assets/images/logo_crizzo_calli3.svg';
import logoPwablo from '../assets/images/logo_pwablo.svg';
import { getEntry } from 'astro:content';

const { pathname } = Astro.url;
const currentLang = pathname.split('/')[1] || 'fr';

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const showArticlesSection = siteConfigEntry?.data?.sectionsVisibility || false;

// Récupérer la configuration de navigation
const navigationEntry = await getEntry('navigation', 'navigation');
const navConfig = navigationEntry?.data?.[currentLang] || navigationEntry?.data?.fr; // Fallback à FR

// Récupérer les traductions UI
const uiTranslationsEntry = await getEntry('ui-translations', 'ui-translations');
const uiTranslations = uiTranslationsEntry?.data?.[currentLang] || uiTranslationsEntry?.data?.fr;

// Année courante pour le copyright
const currentYear = new Date().getFullYear();

const translations = {
  fr: {
    copyright: `© ${currentYear} Christine Rizzo`,
    expertise: "Expertise",
    profil: "Profil",
    honoraires: "Honoraires",
    articles: "Articles",
    contact: "Contact",
    legalNotice: "Mentions légales",
    privacyPolicy: "Politique de confidentialité",
    legalInfo: "Infos légales & CGV",
    design: "Design by Pwablo",
    ecoDesign: "Score d'éco-conception",
    ecoDesignPwablo: "Site web écologique",
    menu: "Menu"
  },
  en: {
    copyright: `© ${currentYear} Christine Rizzo`,
    expertise: "Expertise",
    profil: "Profile",
    honoraires: "Fees",
    articles: "Articles",
    contact: "Contact",
    legalNotice: "Legal Notice",
    privacyPolicy: "Privacy Policy",
    legalInfo: "Legal Info & T&C",
    design: "Design by Pwablo",
    ecoDesign: "Eco-design Score",
    ecoDesignPwablo: "Eco-friendly Website",
    menu: "Menu"
  },
  it: {
    copyright: `© ${currentYear} Christine Rizzo`,
    expertise: "Esperienza",
    profil: "Profilo",
    honoraires: "Onorari",
    articles: "Articoli",
    contact: "Contatto",
    legalNotice: "Note legali",
    privacyPolicy: "Politica sulla riservatezza",
    legalInfo: "Info legali & CGV",
    design: "Design di Pwablo",
    ecoDesign: "Punteggio di eco-design",
    ecoDesignPwablo: "Sito web ecologico",
    menu: "Menu"
  }
};

// Interface for footer configuration
interface PwabloConfig {
  pwabloText?: string;
  pwabloUrl?: string;
}

interface ContactInfo {
  phone: string;
  email: string;
  linkedin: string;
  address: string;
}

interface LegalLink {
  label: string;
  url: string;
}

interface FooterConfig {
  contactInfo?: ContactInfo;
  legalLinks?: LegalLink[];
  ecoDesignTitle?: string;
  ecoDesignText?: string;
  ecoDesignUrl?: string;
  pwablo?: PwabloConfig;
  copyrightText?: string;
  menuTitle?: string;
  contactTitle?: string;
}

// Utiliser les traductions du CMS si disponibles
const t = translations[currentLang as keyof typeof translations] || translations.fr;

const isHomePage = pathname === `/${currentLang}` || pathname === `/${currentLang}/`;

// Fonction pour vérifier si un lien est actif
const isActivePage = (href: string) => {
  // Si c'est la page d'accueil
  if (href === `/${currentLang}` && isHomePage) {
    return true;
  }
  
  // Cas spécial pour le lien "profil"
  if (href.includes('#profil') && pathname === `/${currentLang}/profil`) {
    return true;
  }
  
  // Ignorer les autres liens avec ancre pour l'activation
  if (href.includes('#')) {
    return false;
  }
  
  // Pour les autres pages, vérifier exactement le chemin
  const hrefPath = href.split('#')[0]; // Enlever l'ancre
  return pathname === hrefPath;
};

// Utiliser les données de navigation du CMS
const footerConfig: FooterConfig = navConfig?.footer || {};
const contactInfo = footerConfig.contactInfo || {
  phone: "+32 488 40 45 49",
  email: "c.rizzo@avocat.be",
  linkedin: "https://www.linkedin.com/in/christine-rizzo/",
  address: "Chaussée de Waterloo 1151, 1180 Bruxelles"
};

// Récupérer les liens principaux du Header
const mainLinks = navConfig?.header?.mainLinks || [];

// Liens légaux du Footer
const legalLinks = footerConfig.legalLinks || [
  { label: t.legalNotice, url: `/${currentLang}/legal/notice` },
  { label: t.privacyPolicy, url: `/${currentLang}/legal/privacy` },
  { label: t.legalInfo, url: `/${currentLang}/legal/informations-legales` }
];

// Textes pour la section Eco-design
const ecoDesignTitle = footerConfig.ecoDesignTitle || t.ecoDesignPwablo;
const ecoDesignText = footerConfig.ecoDesignText || t.ecoDesign;
const ecoDesignUrl = footerConfig.ecoDesignUrl || "https://www.websitecarbon.com/website/crizzo-avocate-be-fr/";
const pwabloText = footerConfig.pwablo?.pwabloText || t.design;
const pwabloUrl = footerConfig.pwablo?.pwabloUrl || "https://pwablo.be";
const copyrightText = footerConfig.copyrightText || t.copyright;

// S'assurer que l'année du copyright est toujours l'année en cours
const formattedCopyrightText = `© ${currentYear} ${copyrightText}`;

// Titres des sections
const menuTitle = footerConfig.menuTitle || t.menu;
const contactTitle = footerConfig.contactTitle || t.contact;

// Ajout d'une fonction pour gérer les actions de contact
const handleContactAction = (type: string, action: string) => {
  switch(type) {
    case 'phone':
      return `window.location.href = 'tel:${action}'`;
    case 'email':
      return `window.location.href = 'mailto:${action}'`;
    case 'maps':
      return `window.open('https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(action)}', '_blank')`;
    case 'linkedin':
      return `window.open('${action}', '_blank')`;
    default:
      return '';
  }
};

---

<footer class="bg-beige text-dark-gray py-6 md:py-10">
  <div class="container mx-auto px-4">
    <div class="flex flex-wrap justify-between items-start">
      <div class="w-full md:w-1/3 mb-6 md:mb-0 pr-4 flex justify-center md:justify-start items-center md:items-start md:self-start">
        <Image src={logoImage} alt="Christine Rizzo Logo" class="h-40 md:h-96 w-auto mt-0 md:mt-[-4rem]" />
      </div>
      
      <div class="w-full md:w-1/5 mt-4 md:mt-6 mb-4 md:mb-0">
        <h3 class="font-medium mb-5 text-lg md:text-xl hidden md:block">{menuTitle}</h3>
        <ul class="space-y-3 hidden md:block">
          {mainLinks.map(link => (
            <li>
              <a 
                href={link.url} 
                class={`text-sm md:text-base hover:underline transition-colors duration-300 hover:text-travailleur ${isActivePage(link.url) ? 'font-medium' : ''}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <details class="md:hidden">
          <summary class="font-medium mb-3 text-lg flex justify-between items-center cursor-pointer text-center">
            <span class="w-full">{menuTitle}</span>
            <ChevronDown class="w-5 h-5 absolute right-0" />
          </summary>
          <ul class="space-y-2 mt-2 text-center">
            {mainLinks.map(link => (
              <li>
                <a 
                  href={link.url} 
                  class={`text-sm hover:underline ${isActivePage(link.url) ? 'font-medium' : ''}`}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
      
      <div class="w-full md:w-1/5 mb-4 md:mb-0 mt-4 md:mt-6">
        <h3 class="font-medium mb-5 text-lg md:text-xl hidden md:block">{contactTitle}</h3>
        <div class="hidden md:block">
          <button 
            onclick={handleContactAction('phone', contactInfo.phone)}
            class="text-sm md:text-base flex items-center mb-3 hover:text-travailleur hover:underline cursor-pointer"
          >
            <Phone class="w-5 h-5 mr-3" /> {contactInfo.phone}
          </button>
          
          <button 
            onclick={handleContactAction('email', contactInfo.email)}
            class="text-sm md:text-base flex items-center mb-3 hover:text-travailleur hover:underline cursor-pointer"
          >
            <Mail class="w-5 h-5 mr-3" /> {contactInfo.email}
          </button>

          <button 
            onclick={handleContactAction('linkedin', contactInfo.linkedin)}
            class="text-sm md:text-base flex items-center mb-3 hover:text-travailleur hover:underline cursor-pointer"
          >
            <IconLinkedin class="w-5 h-5 mr-3" /> LinkedIn
          </button>
          
          <button 
            onclick={handleContactAction('maps', contactInfo.address)}
            class="text-sm md:text-base flex items-start hover:text-travailleur hover:underline cursor-pointer w-full text-left"
          >
            <MapPin class="w-5 h-5 mr-3 mt-1 flex-shrink-0" /> 
            <span>
              {contactInfo.address.split(',').map((line, idx) => (
                <Fragment>
                  {idx > 0 && <br />}
                  {line.trim()}
                </Fragment>
              ))}
            </span>
          </button>
        </div>
        <details class="md:hidden">
          <summary class="font-medium mb-3 text-lg flex justify-between items-center cursor-pointer text-center">
            <span class="w-full">{contactTitle}</span>
            <ChevronDown class="w-5 h-5 absolute right-0 transform transition-transform duration-300" />
          </summary>
          <div class="mt-3 flex flex-col items-center space-y-5">
            <button 
              onclick={handleContactAction('phone', contactInfo.phone)}
              class="text-sm flex flex-col items-center hover:text-travailleur hover:underline cursor-pointer"
            >
              <Phone class="w-6 h-6 mb-2" />
              <span>{contactInfo.phone}</span>
            </button>
            
            <button 
              onclick={handleContactAction('email', contactInfo.email)}
              class="text-sm flex flex-col items-center hover:text-travailleur hover:underline cursor-pointer"
            >
              <Mail class="w-6 h-6 mb-2" />
              <span>{contactInfo.email}</span>
            </button>

            <button 
              onclick={handleContactAction('linkedin', contactInfo.linkedin)}
              class="text-sm flex flex-col items-center hover:text-travailleur hover:underline cursor-pointer"
            >
              <IconLinkedin class="w-6 h-6 mb-2" />
              <span>LinkedIn</span>
            </button>
            
            <button 
              onclick={handleContactAction('maps', contactInfo.address)}
              class="text-sm flex flex-col items-center hover:text-travailleur hover:underline cursor-pointer"
            >
              <MapPin class="w-6 h-6 mb-2" />
              <span class="text-center">
                {contactInfo.address.split(',').map((line, idx) => (
                  <Fragment>
                    {idx > 0 && <br />}
                    {line.trim()}
                  </Fragment>
                ))}
              </span>
            </button>
          </div>
        </details>
      </div>
      
      <div class="w-full md:w-1/5 mb-4 md:mb-0 mt-4 md:mt-6">
        <h3 class="font-medium mb-5 text-lg md:text-xl hidden md:block">{ecoDesignTitle}</h3>
        <div class="hidden md:block">
          <a href={ecoDesignUrl} class="text-sm md:text-base hover:underline mb-3 block">{ecoDesignText}</a>
          <a href={pwabloUrl} class="hover:underline flex flex-col items-start">
            <span class="text-sm md:text-base mb-3">{pwabloText}</span>
            <Image src={logoPwablo} alt="Pwablo Logo" class="h-16 md:h-20 my-2 w-auto bg-white p-2 rounded-lg border border-black" />
          </a>
        </div>
        <details class="md:hidden">
          <summary class="font-medium mb-3 text-lg flex justify-between items-center cursor-pointer text-center">
            <span class="w-full">{ecoDesignTitle}</span>
            <ChevronDown class="w-5 h-5 absolute right-0" />
          </summary>
          <div class="mt-2 text-center">
            <a href={ecoDesignUrl} class="text-sm hover:underline mb-2 block">{ecoDesignText}</a>
            <a href={pwabloUrl} class="hover:underline flex flex-col items-center">
              <span class="text-sm mb-2">{pwabloText}</span>
              <Image src={logoPwablo} alt="Pwablo Logo" class="h-16 my-2 w-auto bg-white p-2 rounded-lg border border-black" />
            </a>
          </div>
        </details>
      </div>
    </div>
    
    <div class="mt-4 md:mt-6 pt-3 md:pt-4 border-t border-gray-300 text-center">
      <p class="text-sm md:text-base mb-3 md:mb-4">{formattedCopyrightText}</p>
      <p class="text-xs md:text-sm">
        {legalLinks.map((link, index) => (
          <>
            <a href={link.url} class="hover:underline">{link.label}</a>
            {index < legalLinks.length - 1 && <span class="mx-1 md:mx-2">|</span>}
          </>
        ))}
      </p>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    details summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary .w-5 {
      transform: rotate(180deg);
      transition: transform 0.3s ease;
    }
    details > summary {
      list-style: none;
      position: relative;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details .w-5 {
      transition: transform 0.3s ease;
    }
  }
</style>

<script is:inline>
  // Smooth scrolling for anchor links - improved version
  document.addEventListener('click', function(e) {
    const link = e.target.closest('a');
    if (!link) return;
    
    const href = link.getAttribute('href');
    if (!href || !href.includes('#')) return;
    
    const isCurrentPage = link.pathname === window.location.pathname || 
                          !link.pathname || 
                          link.pathname === '/';

    // Only handle anchor links on the current page
    if (!isCurrentPage && !href.startsWith('#')) return;

    const hash = href.includes('#') ? href.substring(href.indexOf('#')) : '';
    if (!hash) return;
    
    const targetElement = document.querySelector(hash);
    if (!targetElement) return;
    
    e.preventDefault();
    
    // Safari-friendly animation
    const headerOffset = 0;
    const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - headerOffset;
    const startPosition = window.pageYOffset;
    const distance = targetPosition - startPosition;
    
    const duration = 300;
    let startTime = null;
    
    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }
    
    function step(currentTime) {
      if (startTime === null) {
        startTime = currentTime;
      }
      
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = easeOutCubic(progress);
      
      window.scrollTo(0, startPosition + distance * easedProgress);
      
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    }
    
    window.requestAnimationFrame(step);
  });
</script>