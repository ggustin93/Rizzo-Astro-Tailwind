---
import { Image } from 'astro:assets';
import { MapPin, Mail, ChevronDown } from 'astro-feather-icons2';
import IconLinkedin from './IconLinkedIn.astro';
import logoImage from '../assets/images/logo_crizzo_calli3.svg';
import logoPwablo from '../assets/images/logo_pwablo.svg';
import { getEntry } from 'astro:content';
import { localeFromPath } from '../config/locales';
import { getNavigation } from '../utils/navigation';

const { pathname } = Astro.url;
const currentLang = localeFromPath(pathname);

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const lawyers = siteConfigEntry?.data?.lawyers || [];
// Get the shared office address from the root level
const address = siteConfigEntry?.data?.address || "Chaussée de Waterloo 1151, 1180 Bruxelles";

// Récupérer la configuration de navigation
const navConfig = await getNavigation(currentLang);

// Année courante pour le copyright
const currentYear = new Date().getFullYear();

const isHomePage = pathname === `/${currentLang}` || pathname === `/${currentLang}/`;

// Fonction pour vérifier si un lien est actif
const isActivePage = (href: string) => {
  // Si c'est la page d'accueil
  if (href === `/${currentLang}` && isHomePage) {
    return true;
  }
  
  // Cas spécial pour le lien "profil"
  if (href.includes('#profil') && pathname === `/${currentLang}/profil`) {
    return true;
  }
  
  // Ignorer les autres liens avec ancre pour l'activation
  if (href.includes('#')) {
    return false;
  }
  
  // Pour les autres pages, vérifier exactement le chemin
  const hrefPath = href.split('#')[0]; // Enlever l'ancre
  return pathname === hrefPath;
};

// Utiliser les données de navigation du CMS
const footerConfig = navConfig.footer;

if (!lawyers || lawyers.length === 0) {
  // This will stop the build if the contact info is missing, which is what we want.
  throw new Error("FATAL: No lawyers found in site-config.yml for Footer component.");
}

// Récupérer les liens principaux du Header
const mainLinks = navConfig.header.mainLinks;
// Utiliser les liens de menu du footer s'ils existent, sinon fallback sur mainLinks
const footerMenuLinks = footerConfig.menuLinks || mainLinks;

// Ces champs sont requis par navigationSchema : navigation.yml en est la
// source unique, un repli côté composant serait du code mort.
const legalLinks = footerConfig.legalLinks;
const { ecoDesignTitle, ecoDesignText, ecoDesignUrl } = footerConfig;
const { pwabloText, pwabloUrl } = footerConfig.pwablo;
// Récupérer le copyright depuis site-config (source unique de vérité)
const copyrightText = siteConfigEntry?.data?.copyrightText || 'C. Rizzo & S. Michiels';

// S'assurer que l'année du copyright est toujours l'année en cours
const formattedCopyrightText = `© ${currentYear} ${copyrightText}`;

// Titres des sections
const { menuTitle, contactTitle } = footerConfig;


---

<footer class="bg-beige text-dark-gray py-6 md:py-10">
  <div class="container mx-auto px-4">
    <div class="footer-grid grid grid-cols-1 md:grid-cols-[1.2fr_1.2fr_0.9fr_0.9fr] gap-6 md:gap-10 items-start md:grid-rows-[auto]">
      <div class="flex justify-center md:justify-start items-center md:items-start md:self-start">
        <Image src={logoImage} alt="Christine Rizzo Logo" class="footer-logo h-40 md:h-96 w-auto mt-0 md:mt-[-6rem]" />
      </div>

      <div class="footer-contact">
        <h3 class="font-medium mb-5 text-lg md:text-xl">{contactTitle}</h3>
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`} class="flex items-start gap-3 hover:underline">
          <MapPin class="w-5 h-5 flex-shrink-0" />
          <span>{address}</span>
        </a>
        <a href={`mailto:${siteConfigEntry?.data.cabinetEmail}`} class="flex items-center gap-3 mt-4 hover:underline break-all">
          <Mail aria-hidden="true" title="" class="w-5 h-5 flex-shrink-0" />
          <span>{siteConfigEntry?.data.cabinetEmail}</span>
        </a>
      </div>

      <div>
        <h3 class="font-medium mb-5 text-lg md:text-xl hidden md:block">{menuTitle}</h3>
        <ul class="space-y-3 hidden md:block">
          {footerMenuLinks.map(link => (
            <li>
              <a
                href={link.url}
                class={`text-sm md:text-base hover:underline transition-colors duration-300 hover:text-travailleur ${isActivePage(link.url) ? 'font-medium' : ''}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <details class="md:hidden">
          <summary class="relative font-medium mb-3 text-lg flex justify-between items-center cursor-pointer text-center">
            <span class="w-full">{menuTitle}</span>
            <ChevronDown class="w-5 h-5 absolute right-0" />
          </summary>
          <ul class="space-y-2 mt-2 text-center">
            {footerMenuLinks.map(link => (
              <li>
                <a
                  href={link.url}
                  class={`text-sm hover:underline ${isActivePage(link.url) ? 'font-medium' : ''}`}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>

      <div>
        <h3 class="font-medium mb-5 text-lg md:text-xl hidden md:block">{ecoDesignTitle}</h3>
        <div class="hidden md:block">
          <a href={ecoDesignUrl} class="text-sm md:text-base hover:underline mb-3 block">{ecoDesignText}</a>
          <a href={pwabloUrl} class="hover:underline flex flex-col items-start">
            <span class="text-sm md:text-base mb-3">{pwabloText}</span>
            <Image src={logoPwablo} alt="Pwablo Logo" class="h-16 md:h-20 my-2 w-auto bg-white p-2 rounded-lg border border-black" />
          </a>
        </div>
        <details class="md:hidden">
          <summary class="relative font-medium mb-3 text-lg flex justify-between items-center cursor-pointer text-center">
            <span class="w-full">{ecoDesignTitle}</span>
            <ChevronDown class="w-5 h-5 absolute right-0" />
          </summary>
          <div class="mt-2 text-center">
            <a href={ecoDesignUrl} class="text-sm hover:underline mb-2 block">{ecoDesignText}</a>
            <a href={pwabloUrl} class="hover:underline flex flex-col items-center">
              <span class="text-sm mb-2">{pwabloText}</span>
              <Image src={logoPwablo} alt="Pwablo Logo" class="h-16 my-2 w-auto bg-white p-2 rounded-lg border border-black" />
            </a>
          </div>
        </details>
      </div>
    </div>
    
    <div class="mt-4 md:mt-6 pt-3 md:pt-4 border-t border-gray-300 text-center text-gray-700">
      <p class="text-sm md:text-base mb-3 md:mb-4">{formattedCopyrightText}</p>
      <p class="text-xs md:text-sm">
        {legalLinks.map((link, index) => (
          <>
            <a href={link.url} class="hover:underline hover:text-gray-900">{link.label}</a>
            {index < legalLinks.length - 1 && <span class="mx-1 md:mx-2">|</span>}
          </>
        ))}
      </p>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 767px) {
    .footer-grid { gap: 1.25rem; max-width: 26rem; margin-inline: auto; }
    .footer-logo { height: 6rem; max-width: 100%; }
    .footer-contact { text-align: center; }
    .footer-contact h3 { margin-bottom: .75rem; }
    .footer-contact a { justify-content: center; gap: .5rem; font-size: .9375rem; line-height: 1.6; min-height: 44px; }
    .footer-contact a:first-of-type { max-width: 19rem; margin-inline: auto; }
    .footer-contact a:first-of-type :global(svg) { margin-top: .2rem; }
    .footer-contact a + a { margin-top: .35rem; }
    details { border-top: 1px solid #e2dbd3; }
    details > summary { min-height: 48px; margin-bottom: 0; padding: .65rem 1.5rem; font-size: 1rem; }
    details > summary :global(svg) { right: .25rem; }
    details a { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; }
  }

  @media (max-width: 768px) {
    details summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary .w-5 {
      transform: rotate(180deg);
      transition: transform 0.3s ease;
    }
    details > summary {
      list-style: none;
      position: relative;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details .w-5 {
      transition: transform 0.3s ease;
    }
  }
</style>

<script is:inline>
  // Smooth scrolling for anchor links - improved version
  document.addEventListener('click', function(e) {
    const link = e.target.closest('a');
    if (!link) return;
    
    const href = link.getAttribute('href');
    if (!href || !href.includes('#')) return;
    
    const isCurrentPage = link.pathname === window.location.pathname || 
                          !link.pathname || 
                          link.pathname === '/';

    // Only handle anchor links on the current page
    if (!isCurrentPage && !href.startsWith('#')) return;

    const hash = href.includes('#') ? href.substring(href.indexOf('#')) : '';
    if (!hash) return;
    
    const targetElement = document.querySelector(hash);
    if (!targetElement) return;
    
    e.preventDefault();
    
    // Safari-friendly animation
    const headerOffset = 0;
    const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - headerOffset;
    const startPosition = window.pageYOffset;
    const distance = targetPosition - startPosition;
    
    const duration = 300;
    let startTime = null;
    
    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }
    
    function step(currentTime) {
      if (startTime === null) {
        startTime = currentTime;
      }
      
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = easeOutCubic(progress);
      
      window.scrollTo(0, startPosition + distance * easedProgress);
      
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    }
    
    window.requestAnimationFrame(step);
  });
</script>