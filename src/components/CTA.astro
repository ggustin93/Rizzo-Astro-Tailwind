---
import Icon from './Icon.astro';
import { MessageCircle } from 'astro-feather-icons';
import ctaIllustration from '../assets/images/illustration_cta_2.svg';
import { getEntry } from 'astro:content';
import { isValidCalendarLink, calEmbedTarget } from '../utils/calendar.js';

const { pathname } = Astro.url;
const lang = pathname.split('/')[1] || 'fr';

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const lawyers = siteConfigEntry?.data?.lawyers || [];

if (!lawyers || lawyers.length === 0) {
  throw new Error("FATAL: No lawyers found in site-config.yml for CTA component.");
}

const translations = {
  fr: {
    ctaTitle: "Contactez-nous",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "RDV",
    call: "APPEL",
    bookAction: "Réserver"
  },
  en: {
    ctaTitle: "Contact us",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "APPOINTMENT",
    call: "CALL",
    bookAction: "Book"
  },
  it: {
    ctaTitle: "Contattaci",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "APPUNTAMENTO",
    call: "CHIAMA",
    bookAction: "Prenota"
  }
};

const t = translations[lang as keyof typeof translations] || translations.fr;

const handleAction = (type: string, action: string, calendarLink?: string) => {
  switch(type) {
    case 'email':
      return `window.location.href = 'mailto:${action}'`;
    case 'appointment':
      return ''; // Handled by data-cal-link script listener
    case 'phone':
      return `window.location.href = 'tel:${action}'`;
    default:
      return '';
  }
};
---

<div class="full-bleed bg-employeur rounded-lg overflow-hidden">
  <section id="contact" class="py-4 pb-8 sm:py-6 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <!-- Right column appears first on mobile, second on desktop -->
        <div class="lg:w-2/5 flex flex-col items-center justify-start order-first lg:order-last">
          <!-- Title visible on all screen sizes -->
          <div class="flex items-center mb-4 w-full justify-center pt-0">
            <div class="w-12 sm:w-16 lg:w-16 h-px bg-white/40 mr-3"></div>
            <h2 class="text-lg sm:text-xl lg:text-2xl font-light text-white uppercase flex items-center whitespace-nowrap tracking-widest">
              <MessageCircle class="w-4 h-4 sm:w-5 sm:h-5 mr-2 text-accent" />
              {t.ctaTitle}
            </h2>
            <div class="w-12 sm:w-16 lg:w-16 h-px bg-white/40 ml-3"></div>
          </div>
          <!-- Image below the title -->
          <img
            src={ctaIllustration.src}
            alt="Contact illustration"
            class="w-full h-auto max-w-[200px] sm:max-w-[240px] lg:max-w-[280px] opacity-75 drop-shadow-[0_0_12px_rgba(255,255,255,0.1)]"
            width={280}
            height={112}
            loading="lazy"
          />
        </div>
        
        <!-- Left column appears second on mobile, first on desktop -->
        <div class="lg:w-3/5 text-center lg:text-left order-last lg:order-first">
          <div class="space-y-4 max-w-2xl mx-auto lg:mx-0">
            {lawyers.map((lawyer: any, index: number) => (
              <div class={`${index > 0 ? 'pt-4 border-t border-white/20' : ''}`}>
                <h3 class="text-xl font-medium text-accent mb-3 text-center">
                  {lawyer.name}
                </h3>
                <div class="grid grid-cols-3 gap-2 sm:gap-3 max-w-md mx-auto">
                  <!-- Email Button -->
                  <div class="flex flex-col items-center">
                    <button
                      class="w-16 h-16 sm:w-20 sm:h-20 bg-white rounded-full flex items-center justify-center mb-2 hover:bg-travailleur hover:shadow-lg transition-all duration-300 transform hover:scale-105 group cursor-pointer"
                      onclick={handleAction('email', lawyer.email)}
                      aria-label={`Email ${lawyer.name}`}
                    >
                      <Icon name="mail" class="w-7 h-7 sm:w-8 sm:h-8 text-employeur group-hover:text-white transition-colors duration-300 pointer-events-none"/>
                    </button>
                    <span class="text-sm uppercase text-white/90 font-medium tracking-wider mb-1">{t.email}</span>
                    <button 
                      class="text-xs sm:text-sm text-white/70 font-light hover:text-white transition-colors duration-200 hover:underline cursor-pointer max-w-full break-all px-1"
                      onclick={handleAction('email', lawyer.email)}
                      title={lawyer.email}
                    >
                      {lawyer.email || ''}
                    </button>
                  </div>
                  
                  <!-- Appointment Button -->
                  <div class="flex flex-col items-center">
                    {isValidCalendarLink(lawyer.calendarLink) ? (
                      <>
                        <button
                          class="w-16 h-16 sm:w-20 sm:h-20 bg-white rounded-full flex items-center justify-center mb-2 hover:bg-travailleur hover:shadow-lg transition-all duration-300 transform hover:scale-105 group cursor-pointer"
                          onclick={handleAction('appointment', t.bookAction, lawyer.calendarLink)}
                          data-cal-link={calEmbedTarget(lawyer.calendarLink)}
                          data-cal-config='{"layout":"month_view"}'
                          aria-label={`Book appointment with ${lawyer.name}`}
                        >
                          <Icon name="calendar" class="w-7 h-7 sm:w-8 sm:h-8 text-employeur group-hover:text-white transition-colors duration-300 pointer-events-none" />
                        </button>
                        <span class="text-sm uppercase text-white/90 font-medium tracking-wider mb-1">{t.appointment}</span>
                        <button 
                          class="text-sm sm:text-base text-white/70 font-light hover:text-white transition-colors duration-200 hover:underline cursor-pointer"
                          onclick={handleAction('appointment', t.bookAction, lawyer.calendarLink)}
                          data-cal-link={calEmbedTarget(lawyer.calendarLink)}
                          data-cal-config='{"layout":"month_view"}'
                        >
                          {t.bookAction}
                        </button>
                      </>
                    ) : (
                      <>
                        <div
                          class="w-16 h-16 sm:w-20 sm:h-20 bg-white/50 rounded-full flex items-center justify-center mb-2 cursor-not-allowed opacity-50"
                          aria-label={`Appointment booking not available for ${lawyer.name}`}
                        >
                          <Icon name="calendar" class="w-7 h-7 sm:w-8 sm:h-8 text-employeur/50 pointer-events-none" />
                        </div>
                        <span class="text-sm uppercase text-white/50 font-medium tracking-wider mb-1">{t.appointment}</span>
                        <span class="text-sm sm:text-base text-white/30 font-light">
                          -
                        </span>
                      </>
                    )}
                  </div>
                  
                  <!-- Phone Button -->
                  <div class="flex flex-col items-center">
                    <button
                      class="w-16 h-16 sm:w-20 sm:h-20 bg-white rounded-full flex items-center justify-center mb-2 hover:bg-travailleur hover:shadow-lg transition-all duration-300 transform hover:scale-105 group cursor-pointer"
                      onclick={handleAction('phone', lawyer.phone)}
                      aria-label={`Call ${lawyer.name}`}
                    >
                      <Icon name="phone" class="w-7 h-7 sm:w-8 sm:h-8 text-employeur group-hover:text-white transition-colors duration-300 pointer-events-none" />
                    </button>
                    <span class="text-sm uppercase text-white/90 font-medium tracking-wider mb-1">{t.call}</span>
                    <button 
                      class="text-sm sm:text-base text-white/70 font-light hover:text-white transition-colors duration-200 hover:underline cursor-pointer whitespace-nowrap"
                      onclick={handleAction('phone', lawyer.phone)}
                    >
                      {lawyer.phone || ''}
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const appointmentButtons = document.querySelectorAll('[data-cal-link]');
    appointmentButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        // @ts-ignore
        if (typeof Cal !== 'undefined') {
          (window as any).Cal("ui", {
            styles: {branding: {brandColor: "#000000"}},
            hideEventTypeDetails: false,
            layout: "month_view"
          });
        }
      });
    });
  });
</script>