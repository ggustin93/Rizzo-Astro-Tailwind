---
import { Calendar, Mail, Phone, MessageCircle } from 'astro-feather-icons';
import ctaIllustration from '../assets/images/illustration_cta_2.svg';
import { getEntry } from 'astro:content';

const { pathname } = Astro.url;
const lang = pathname.split('/')[1] || 'fr';

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const calendarLink = siteConfigEntry?.data?.calendarLink || 'https://cal.com/c.rizzo-avocat.be/rendez-vous?duration=15';
const contactInfo = siteConfigEntry?.data?.contactInfo || {
  phone: '+32 488 40 45 49',
  whatsapp: '32488404549',
  email: 'c.rizzo@avocat.be'
};

const translations = {
  fr: {
    ctaTitle: "Contactez-moi",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "RDV",
    call: "APPEL",
    whatsapp: "WHATSAPP",
    bookAction: "Réserver",
    chatAction: "Discuter"
  },
  en: {
    ctaTitle: "Contact me",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "APPOINTMENT",
    call: "CALL",
    whatsapp: "WHATSAPP",
    bookAction: "Book",
    chatAction: "Chat"
  },
  it: {
    ctaTitle: "Contattami",
    ctaSubtitle: "",
    email: "EMAIL",
    appointment: "APPUNTAMENTO",
    call: "CHIAMA",
    whatsapp: "WHATSAPP",
    bookAction: "Prenota",
    chatAction: "Chat"
  }
};

const t = translations[lang as keyof typeof translations] || translations.fr;

const buttonConfig = [
  { icon: Mail, text: t.email, action: contactInfo.email, type: 'email' },
  { icon: Calendar, text: t.appointment, action: t.bookAction, type: 'appointment' },
  { icon: Phone, text: t.call, action: contactInfo.phone, type: 'phone' },
  { icon: MessageCircle, text: t.whatsapp, action: t.chatAction, type: 'whatsapp' },
];

const handleAction = (type: string, action: string) => {
  switch(type) {
    case 'email':
      return `window.location.href = 'mailto:${action}'`;
    case 'appointment':
      return `Cal('ui', {"styles":{"branding":{"brandColor":"#000000"}},"hideEventTypeDetails":false,"layout":"month_view"})`;
    case 'phone':
      return `window.location.href = 'tel:${action}'`;
    case 'whatsapp':
      return `window.open('https://wa.me/${contactInfo.whatsapp}', '_blank')`;
    default:
      return '';
  }
};
---

<div class="full-bleed bg-employeur rounded-lg overflow-hidden">
  <section id="contact" class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="md:w-1/2 text-center md:text-left">
          <div class="flex items-center mb-6 justify-center md:justify-start">
            <div class="flex-grow h-px bg-gray-300 md:max-w-xs max-w-[40px] mr-2 md:mr-4"></div>
            <h2 class="text-xl sm:text-2xl font-light text-white uppercase flex items-center">
              <MessageCircle class="w-5 h-5 md:w-6 md:h-6 mr-2 md:mr-3 text-white" />
              {t.ctaTitle}
            </h2>
            <div class="flex-grow h-px bg-gray-300 md:max-w-xs max-w-[40px] ml-2 md:ml-4"></div>
          </div>
          <p class="mb-8 text-lg md:text-xl font-light text-white">{t.ctaSubtitle}</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-2xl mx-auto md:mx-0">
            {buttonConfig.map(({ icon: Icon, text, action, type }) => (
              <div class="flex flex-col items-center">
                <button
                  class="w-20 h-20 md:w-24 md:h-24 bg-white rounded-full flex items-center justify-center mb-3 md:mb-5 hover:bg-travailleur hover:shadow-lg transition-all duration-300 transform hover:scale-105 group cursor-pointer"
                  onclick={handleAction(type, action)}
                  data-cal-link={type === 'appointment' ? calendarLink.replace('https://cal.com/', '') : undefined}
                  data-cal-config={type === 'appointment' ? '{"layout":"month_view"}' : undefined}
                >
                  <Icon class="w-10 h-10 md:w-12 md:h-12 text-employeur group-hover:text-white transition-colors duration-300 pointer-events-none" />
                </button>
                <span class="text-sm md:text-base uppercase text-white font-semibold tracking-wider leading-relaxed mb-1 md:mb-2 px-2 text-center">{text}</span>
                <button 
                  class="text-sm md:text-base text-gray-300 font-normal italic hover:text-white transition-colors duration-300 hover:underline cursor-pointer"
                  onclick={handleAction(type, action)}
                  data-cal-link={type === 'appointment' ? calendarLink.replace('https://cal.com/', '') : undefined}
                  data-cal-config={type === 'appointment' ? '{"layout":"month_view"}' : undefined}
                >
                  {action}
                </button>
              </div>
            ))}
          </div>
        </div>
        <div class="md:w-1/2 md:mb-0 flex justify-center md:justify-end mt-8 md:mt-0">
          <img
            src={ctaIllustration.src}
            alt="illustration cta"
            class="w-full h-auto max-w-md"
            width={500}
            height={200}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const appointmentButtons = document.querySelectorAll('[data-cal-link]');
    appointmentButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        // @ts-ignore
        if (typeof Cal !== 'undefined') {
          (window as any).Cal("ui", {
            styles: {branding: {brandColor: "#000000"}},
            hideEventTypeDetails: false,
            layout: "month_view"
          });
        }
      });
    });
  });
</script>