---
import { Picture } from 'astro:assets';
import { MessageCircle, Mail, Calendar, Phone, ArrowUpRight, ChevronDown } from 'astro-feather-icons2';
import { getEntry } from 'astro:content';
import { bookableLawyers, calEmbedTarget } from '../utils/calendar.js';
import { localeFromPath } from '../config/locales';
import { getUiTranslations } from '../utils/ui-translations';

const lang = localeFromPath(Astro.url.pathname);
const entry = await getEntry('config', 'site-config');
if (!entry) throw new Error('Missing site configuration');
const config = entry.data;
const t = (await getUiTranslations(lang)).cta;
const actionIcons = { message: MessageCircle, email: Mail, appointment: Calendar, phone: Phone };
const actions = t.actions.filter(action => action.type !== 'message' || config.showContactForm);
---

<div class="full-bleed bg-employeur rounded-lg overflow-hidden">
  <section id="contact" class="contact-banner">
    <div class="container mx-auto flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <div class="contact-content">
        <h2 class="contact-heading">{t.title}</h2>
        <div class="contact-options">
        {actions.map(action => {
          const ActionIcon = actionIcons[action.type];
          return (
          <div class="min-w-0">
            {['message', 'email'].includes(action.type) ? (
              <a class="contact-action contact-card" href={action.type === 'message' ? `/${lang}/contact/#contact-form` : `mailto:${config.cabinetEmail}`}>
                <span class="action-icon"><ActionIcon aria-hidden="true" title="" /></span>
                <span class="action-copy">
                  <span class="action-title">{action.label}</span>

                  {action.type === 'email' && <span class="action-email">{config.cabinetEmail}</span>}
                </span>
                <ArrowUpRight aria-hidden="true" title="" class="action-indicator" />
              </a>
            ) : (
              <details class="contact-card contact-disclosure">
                <summary class="contact-action cursor-pointer">
                  <span class="action-icon"><ActionIcon aria-hidden="true" title="" /></span>
                  <span class="action-copy">
                    <span class="action-title">{action.label}</span>

                  </span>
                  <ChevronDown aria-hidden="true" title="" class="action-indicator" />
                </summary>
                <ul class="contact-choices">
                  {(action.type === 'phone' ? config.lawyers : bookableLawyers(config.lawyers)).map(lawyer => (
                    <li>
                      <a class="contact-choice"
                        href={action.type === 'phone' ? `tel:${lawyer.phone.replace(/\s/g, '')}` : lawyer.calendarLink}
                        data-cal-link={action.type === 'appointment' ? calEmbedTarget(lawyer.calendarLink) : undefined}
                        data-cal-config={action.type === 'appointment' ? '{"layout":"month_view"}' : undefined}>
                        <span>
                          <span class="choice-name">{lawyer.name}</span>
                          {action.type === 'phone' && <span class="choice-phone">{lawyer.phone}</span>}
                        </span>
                        <ArrowUpRight aria-hidden="true" title="" class="choice-arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        ); })}
        </div>
      </div>
      <div class="contact-illustration">
        <Picture src={config.contactIllustration} alt={t.illustrationAlt} class="w-full h-auto max-w-[220px] opacity-75" width="280" height="112" loading="lazy" />
      </div>
    </div>
  </section>
</div>
<style>
  .contact-banner { padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 4vw, 3rem); }
  .contact-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; width: 100%; align-items: start; }
  .contact-card { background: #fffdfa; border: 1px solid rgba(255,255,255,.55); border-radius: 14px; color: #363b70; box-shadow: 0 2px 4px rgba(27,31,66,.04); }
  .contact-action { display: grid; grid-template-columns: 42px minmax(0, 1fr) 18px; align-items: center; gap: .85rem; padding: 1rem 1.2rem; min-height: 90px; cursor: pointer; text-decoration: none; transition: background-color .18s, border-color .18s; }
  .contact-action:hover { background: #f5f3fc; border-color: #dadcf4; }
  .action-icon { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 12px; background: #edecf7; color: #53599a; }
  .action-icon :global(svg) { width: 21px; height: 21px; stroke-width: 1.6; }
  .action-copy { min-width: 0; padding-top: .05rem; }
  .action-title { display: block; font-size: 1.1rem; line-height: 1.4; font-weight: 600; }
  .action-email { display: block; margin-top: .25rem; font-size: .8rem; line-height: 1.4; color: #454b89; overflow-wrap: anywhere; }
  .contact-action :global(.action-indicator) { width: 18px; height: 18px; margin-top: .25rem; color: #7c80a6; transition: transform .18s; }
  summary.contact-action { list-style: none; border-radius: 13px; }
  summary.contact-action::-webkit-details-marker { display: none; }
  .contact-disclosure[open] summary :global(.action-indicator) { transform: rotate(180deg); }
  .contact-disclosure[open] summary { min-height: 0; background: #f5f3fc; border-radius: 13px 13px 0 0; }
  .contact-choices { margin: 0 1.1rem; padding: .45rem 0; border-top: 1px solid #e1e2ef; list-style: none; }
  .contact-choices li + li { border-top: 1px solid #eeedf3; }
  .contact-choice { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .85rem .2rem; border-radius: 5px; text-decoration: none; }
  .contact-choice:hover { color: #06616c; background: #f2f7f7; }
  .choice-name { display: block; font-size: .9rem; line-height: 1.45; overflow-wrap: anywhere; }
  .choice-phone { display: block; font-size: .82rem; color: #61637c; margin-top: .2rem; }
  .contact-choice :global(.choice-arrow) { width: 16px; height: 16px; flex-shrink: 0; }
  .contact-action:focus-visible, .contact-choice:focus-visible { outline: 3px solid #ffcc33; outline-offset: 4px; }
  .contact-content { width: 100%; min-width: 0; }
  .contact-heading { margin: 0 0 1.25rem; color: white; font-size: clamp(1.6rem, 2.5vw, 2rem); line-height: 1.2; font-weight: 400; letter-spacing: -.02em; }
  .contact-illustration { position: relative; display: flex; justify-content: center; flex-shrink: 0; isolation: isolate; }
  .contact-illustration::before, .contact-illustration::after { content: ''; position: absolute; pointer-events: none; z-index: -1; width: 250px; height: 250px; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .contact-illustration::after { width: 290px; height: 290px; border-style: dashed; border-color: rgba(255,255,255,.09); }
  @media (min-width: 1024px) { .contact-content { flex: 1; } .contact-illustration { width: 28%; } }
  @media (max-width: 1023px) { .contact-illustration { display: none; } }
  @media (max-width: 639px) {
    .contact-options { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    .contact-action { min-height: 0; padding: 1.2rem; }
    .action-title { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-action, .contact-action :global(.action-indicator) { transition: none; } }
</style>
