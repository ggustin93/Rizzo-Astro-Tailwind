---
import logoImage from '../assets/images/logo_crizzo_calli3.svg';
import LanguagePicker from '../components/LanguagePicker.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { LOCALES } from '../config/locales';
import { bookableLawyers, calEmbedTarget } from '../utils/calendar.js';
import { getUiTranslations, type SupportedLanguage } from '../utils/ui-translations';

export interface Props {
  currentLang: string;
}

const { pathname } = Astro.url;
const currentLang = pathname.split('/')[1] || 'fr'; // Par défaut à 'fr' si aucune langue n'est trouvée

// Langues disponibles pour le site
const langs = LOCALES;

// Récupérer la configuration du site
const siteConfigEntry = await getEntry('config', 'site-config');
const showArticlesSection = siteConfigEntry?.data?.sectionsVisibility || false;

// Booking rows come from the lawyers array in site-config, not duplicated nav
// YAML, and only for lawyers who actually have a calendar (issue #9).
const lawyersToBook = bookableLawyers(siteConfigEntry?.data?.lawyers);

// Récupérer la configuration de navigation
const navigationEntry = await getEntry('navigation', 'navigation');
const navConfig = navigationEntry?.data?.[currentLang] || navigationEntry?.data?.fr; // Fallback à FR

// Récupérer les traductions UI
const uiTranslations = await getUiTranslations(currentLang as SupportedLanguage);

// Libellés de repli si le CMS ne fournit rien. Les libellés de navigation
// viennent de navigation.yml (mainLinks), pas d'ici.
const fallbackContactLabel = { fr: 'ME CONTACTER', en: 'CONTACT ME', it: 'CONTATTAMI' };

const isHomePage = pathname === `/${currentLang}` || pathname === `/${currentLang}/`;

// Fonction pour vérifier si un lien est actif
const isActivePage = (href: string) => {
  // Si c'est la page d'accueil
  if (href === `/${currentLang}` && isHomePage) {
    // Vérifier si nous sommes exactement sur la page d'accueil (sans sous-chemin)
    return pathname === `/${currentLang}` || pathname === `/${currentLang}/`;
  }
  
  // Cas spécial pour le lien "profil"
  if (href.includes('#profil') && pathname === `/${currentLang}/profil`) {
    return true;
  }
  
  // Ignorer les autres liens avec ancre pour l'activation
  if (href.includes('#')) {
    return false;
  }
  
  // Pour les autres pages, vérifier exactement le chemin
  const hrefPath = href.split('#')[0]; // Enlever l'ancre
  return pathname === hrefPath;
};

// Vérifier si nous sommes sur une page de services
const isServicesPage = pathname.includes(`/${currentLang}/services/`);

// Vérifier si nous sommes sur la page profil
const isProfilPage = pathname === `/${currentLang}/profil`;

// Utiliser la configuration de navigation du CMS si disponible
const mainLinks = navConfig?.header?.mainLinks || [];

// Construire les liens de navigation principaux et secondaires
const leftNavLinks = mainLinks.filter((link, index) => index < 3).map(link => ({
  href: link.url,
  label: link.label,
  hasDropdown: link.hasDropdown,
  dropdownItems: link.dropdownItems,
  isActive: link.url.includes('/services/') ? isServicesPage : 
            link.url.includes('#profil') || link.url.includes('/profil') ? isProfilPage : 
            isActivePage(link.url)
}));

const rightNavLinks = showArticlesSection ? 
  mainLinks.filter((link, index) => index >= 3).map(link => ({
    href: link.url,
    label: link.label,
    isActive: isActivePage(link.url)
  })) : 
  mainLinks.filter((link, index) => index >= 3 && !link.url.includes('/blog')).map(link => ({
    href: link.url,
    label: link.label,
    isActive: isActivePage(link.url)
  }));

// Texte du bouton Contact depuis la configuration
const contactButtonText =
  navConfig?.header?.contactButtonText || fallbackContactLabel[currentLang] || fallbackContactLabel.fr;

// Libellés du menu de réservation, éditables dans le CMS (ui-translations).
const bookingLabels = uiTranslations?.additionalTranslations;
const bookWithLabel = bookingLabels?.bookWith ?? 'Prendre rendez-vous avec';
const contactFormLabel = bookingLabels?.contactForm ?? 'Formulaire de contact';
---

<style>
  /* Style pour indiquer la page active */
  .nav-link {
    position: relative;
    padding-top: 0.5rem;
  }
  
  .nav-link.active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: currentColor;
    opacity: 0.7;
  }
  
  /* Animation au hover pour les liens non-actifs */
  .nav-link:not(.active)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: currentColor;
    opacity: 0.5;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  
  .nav-link:not(.active):hover::before {
    transform: scaleX(1);
  }
  
  /* Style pour le menu mobile */
  .mobile-nav-link.active {
    font-weight: 400;
    border-left: 1px solid black;
    padding-left: 0.5rem;
  }
  
  /* Amélioration des effets hover sur mobile */
  .mobile-nav-link {
    position: relative;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  
  .mobile-nav-link:hover, 
  .mobile-submenu-link:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }
  
  .mobile-nav-link:active, 
  .mobile-submenu-link:active {
    transform: scale(0.98);
  }
  
  /* Animation pour les sous-menus */
  .mobile-submenu-link {
    position: relative;
    transition: background-color 0.2s ease, transform 0.1s ease, padding-left 0.2s ease;
  }
  
  .mobile-submenu-link:hover {
    padding-left: 0.5rem;
  }
  
  .mobile-submenu-link.active {
    font-weight: 400;
    padding-left: 0.5rem;
    background-color: rgba(0, 0, 0, 0.05);
  }
</style>

<header class="py-2 my-4 lg:py-6 lg:my-8">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center">
      <!-- Menu hamburger for mobile and tablet -->
      <button id="menu-toggle" class="lg:hidden text-black z-20 p-2 -m-2" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      
      <!-- Logo (visible on all screens) -->
      <div class="logo text-center flex-grow lg:flex-grow-0 lg:absolute lg:left-1/2 lg:transform lg:-translate-x-1/2">
        <a href={`/${currentLang}`}>
          <img src={logoImage.src} alt="Christine Rizzo Logo" class="h-20 sm:h-24 md:h-28 lg:h-32 w-auto mx-auto" />
        </a>
      </div>
      
      <!-- Left navigation for desktop -->
      <nav class="hidden lg:flex space-x-8 items-center">
        {leftNavLinks.map(link => (
          link.hasDropdown ? (
            <div class="relative group">
              <a 
                href={link.href} 
                class={`nav-link text-black uppercase text-sm font-light inline-flex items-center ${link.isActive ? 'active' : ''}`}
              >
                {link.label}
                <Icon name="chevron-down" class="w-4 h-4 ml-1" />
              </a>
              <div class="absolute left-0 mt-1 w-56 bg-white shadow-lg rounded-sm z-50 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-300 py-2">
                  {link.dropdownItems?.map(item => (
                    <a
                      href={item.url}
                      class={`block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 ${isActivePage(item.url) ? 'font-medium' : ''}`}
                    >
                      {item.label}
                    </a>
                  ))}
              </div>
            </div>
          ) : (
            <a 
              href={link.href} 
              class={`nav-link text-black uppercase text-sm font-light ${link.isActive || isActivePage(link.href) ? 'active' : ''}`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>
      
      <!-- Right navigation for desktop -->
      <div class="hidden lg:flex items-center space-x-6">
        {rightNavLinks.map(link => (
          <a 
            href={link.href} 
            class={`nav-link text-black uppercase text-sm font-light ${isActivePage(link.href) ? 'active' : ''}`}
          >
            {link.label}
          </a>
        ))}
        <div class="flex items-center space-x-4">
          <!-- Booking dropdown: same hover interaction as the Services menu,
               plus focus-within so it opens for keyboard users too. -->
          <div class="relative group">
            <Button
              href={`/${currentLang}/contact`}
              text={contactButtonText}
              variant="secondary"
              class={`py-1 px-3 text-sm ${isActivePage(`/${currentLang}/contact`) ? 'font-medium' : ''}`}
            />
            <div
              id="header-booking-desktop"
              class="absolute right-0 mt-1 w-64 bg-white shadow-lg rounded-sm z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-300 py-2"
            >
              {lawyersToBook.map(lawyer => (
                <button
                  type="button"
                  class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer"
                  data-cal-link={calEmbedTarget(lawyer.calendarLink)}
                  data-cal-config='{"layout":"month_view"}'
                  aria-label={`${bookWithLabel} ${lawyer.name}`}
                >
                  {lawyer.name}
                </button>
              ))}
              <a
                href={`/${currentLang}/contact`}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 border-t border-gray-100 mt-1 pt-2"
              >
                {contactFormLabel}
              </a>
            </div>
          </div>

          <LanguagePicker currentLang={currentLang} />
        </div>
      </div>
    </div>
    
    <!-- Mobile and tablet menu -->
    <nav id="mobile-menu" class="lg:hidden fixed inset-0 bg-beige bg-opacity-95 z-50 flex flex-col justify-center items-center hidden">
      <button id="close-menu" class="absolute top-4 right-4 text-black z-20" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <!-- Menu principal pour mobile avec style amélioré et simplifié -->
      <div class="w-64 mx-auto text-center">
        <!-- Afficher tous les liens de navigation principaux -->
        {mainLinks.map((link, index) => (
          link.hasDropdown ? (
            <div class="mb-4">
              <a 
                href={link.url}
                class={`mobile-nav-link block py-3 text-black uppercase text-base font-light border-b border-gray-200 ${
                  link.url.includes('/services/') ? isServicesPage : isActivePage(link.url) ? 'active' : ''
                }`}
              >
                {link.label}
              </a>
              
              <!-- Sous-menu services simplifié (toujours visible) -->
              <div class="py-2 px-4 bg-white bg-opacity-60 rounded-sm my-2">
                {link.dropdownItems?.map(item => (
                  <a 
                    href={item.url} 
                    class={`mobile-submenu-link block py-2 text-black text-sm font-light transition-colors duration-300 ${isActivePage(item.url) ? 'active' : ''}`}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a 
              href={link.url} 
              class={`mobile-nav-link block py-3 text-black uppercase text-base font-light border-b border-gray-200 ${
                link.url.includes('#profil') && isProfilPage ? 'active' : isActivePage(link.url) ? 'active' : ''
              }`}
            >
              {link.label}
            </a>
          )
        ))}
        
        <!-- Booking rows use the always-open submenu pattern, like Services and
             Team above: no hover target exists on touch. -->
        <div id="header-booking-mobile" class="mt-6">
          <Button
            href={`/${currentLang}/contact`}
            text={contactButtonText}
            variant="secondary"
            class={`text-base py-3 px-6 ${isActivePage(`/${currentLang}/contact`) ? 'font-medium' : ''}`}
          />
          <div class="py-2 px-4 bg-white bg-opacity-60 rounded-sm my-2">
            {lawyersToBook.map(lawyer => (
              <button
                type="button"
                class="mobile-submenu-link block w-full py-2 text-black text-sm font-light transition-colors duration-300 cursor-pointer"
                data-cal-link={calEmbedTarget(lawyer.calendarLink)}
                data-cal-config='{"layout":"month_view"}'
                aria-label={`${bookWithLabel} ${lawyer.name}`}
              >
                {lawyer.name}
              </button>
            ))}
            <a
              href={`/${currentLang}/contact`}
              class={`mobile-submenu-link block py-2 text-black text-sm font-light transition-colors duration-300 ${isActivePage(`/${currentLang}/contact`) ? 'active' : ''}`}
            >
              {contactFormLabel}
            </a>
          </div>
        </div>
        
        <!-- Sélecteur de langue simplifié pour mobile -->
        <div class="mt-8 py-4 border-t border-gray-200 pt-6 flex justify-center">
          <div class="flex items-center space-x-4">
            <span class="text-black text-sm font-light">{currentLang.toUpperCase()}</span>
            {langs.filter(lang => lang !== currentLang).map(lang => (
              <a 
                href={pathname.replace(`/${currentLang}`, `/${lang}`)} 
                class="text-gray-500 text-sm font-light hover:text-black transition-colors duration-300"
              >
                {lang.toUpperCase()}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu functionality - compatible with Astro View Transitions
  function initMobileMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const closeMenu = document.getElementById('close-menu');
    const mobileMenu = document.getElementById('mobile-menu');
    
    function toggleMobileMenu() {
      if (mobileMenu) {
        mobileMenu.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');
      }
    }
    
    if (menuToggle) {
      menuToggle.addEventListener('click', function(e) {
        e.preventDefault();
        toggleMobileMenu();
      });
    }

    if (closeMenu) {
      closeMenu.addEventListener('click', function(e) {
        e.preventDefault();
        toggleMobileMenu();
      });
    }
    
    // Close menu when clicking outside
    if (mobileMenu) {
      mobileMenu.addEventListener('click', function(e) {
        if (e.target === mobileMenu) {
          toggleMobileMenu();
        }
      });
    }
    
    // Close menu on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
        toggleMobileMenu();
      }
    });
  }
  
  // Initialize on first load
  initMobileMenu();
  
  // Re-initialize after Astro page transitions
  document.addEventListener('astro:after-swap', initMobileMenu);
  
  // Smooth scrolling for anchor links - improved version
  document.addEventListener('click', function(e) {
    const target = e.target as HTMLElement;
    if (!target) return;
    const link = target.closest('a');
    if (!link) return;
    
    const href = link.getAttribute('href');
    if (!href || !href.includes('#')) return;
    
    const isCurrentPage = link.pathname === window.location.pathname || 
                          !link.pathname || 
                          link.pathname === '/';

    // Only handle anchor links on the current page
    if (!isCurrentPage && !href.startsWith('#')) return;

    const hash = href.includes('#') ? href.substring(href.indexOf('#')) : '';
    if (!hash) return;
    
    const targetElement = document.querySelector(hash);
    if (!targetElement) return;
    
    e.preventDefault();
    
    // Safari-friendly animation
    const headerOffset = 0 //100;
    const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - headerOffset;
    const startPosition = window.pageYOffset;
    const distance = targetPosition - startPosition;
    
    // Keep the user-modified duration of 1000ms
    const duration = 300;
    let startTime: number | null = null;
    
    // Using a simpler easing function optimized for Safari
    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }
    
    function step(currentTime: number) {
      if (startTime === null) {
        startTime = currentTime;
      }
      
      const elapsed = currentTime - startTime!;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = easeOutCubic(progress);
      
      window.scrollTo(0, startPosition + distance * easedProgress);
      
      // Continue animation if we're not done yet
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    }
    
    // Start the animation
    window.requestAnimationFrame(step);
  });
</script>