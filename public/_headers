# Cache control pour les pages HTML
/index.html
  Cache-Control: no-store 

# Règle globale d'indexation pour tous les chemins
/*
  X-Robots-Tag: index, follow
  
# Règle spécifique pour Googlebot avec une directive forte d'indexation
/fr/*
  X-Robots-Tag: index, follow
  X-Googlebot-Specific: index 